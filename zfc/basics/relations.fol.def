include "functions.fol.def"

# ============================================================
# Relations: is_relation, Domain Set, Range Set, Inverse, Image
# ============================================================

# is_relation(r) means every element of r is an ordered pair
@def(is_relation) axiom is_relation_def: forall r.
    (is_relation(r) <-> forall z. (elem(z, r) ->
        exists x. exists y. pair(z, x, y)))

# domain_set(d, r) means d is the set of all first components of pairs in r
@def(domain_set) axiom domain_set_def: forall d. forall r.
    (domain_set(d, r) <-> forall x. (elem(x, d) <-> exists y. rel_elem(r, x, y)))

# range_set(g, r) means g is the set of all second components of pairs in r
@def(range_set) axiom range_set_def: forall g. forall r.
    (range_set(g, r) <-> forall y. (elem(y, g) <-> exists x. rel_elem(r, x, y)))

# inverse(s, r) means s is the relation with all pairs reversed
@def(inverse) axiom inverse_def: forall s. forall r.
    (inverse(s, r) <-> forall x. forall y. (rel_elem(s, x, y) <-> rel_elem(r, y, x)))

# image(t, r, a) means t = { y | exists x in a. (x, y) in r }
@def(image) axiom image_def: forall t. forall r. forall a.
    (image(t, r, a) <-> forall y. (elem(y, t) <-> exists x. (elem(x, a) & rel_elem(r, x, y))))

# ============================================================
# Domain Set Claims
# ============================================================

# If x is in the domain set, then x is in_domain
claim domain_set_elem: forall d. forall r. forall x.
    ((domain_set(d, r) & elem(x, d)) -> in_domain(r, x))

# If x is in_domain, then x is in the domain set
claim in_domain_elem: forall d. forall r. forall x.
    ((domain_set(d, r) & in_domain(r, x)) -> elem(x, d))

# Domain set is unique
claim domain_set_unique: forall d1. forall d2. forall r.
    ((domain_set(d1, r) & domain_set(d2, r)) -> eq(d1, d2))

# ============================================================
# Range Set Claims
# ============================================================

# Range set is unique
claim range_set_unique: forall g1. forall g2. forall r.
    ((range_set(g1, r) & range_set(g2, r)) -> eq(g1, g2))

# ============================================================
# Inverse Claims
# ============================================================

# Forward: rel_elem in the inverse means rel_elem with swapped args in the original
claim inverse_fwd: forall s. forall r. forall x. forall y.
    ((inverse(s, r) & rel_elem(s, x, y)) -> rel_elem(r, y, x))

# Reverse: rel_elem in the original means rel_elem with swapped args in the inverse
claim inverse_rev: forall s. forall r. forall x. forall y.
    ((inverse(s, r) & rel_elem(r, x, y)) -> rel_elem(s, y, x))

# Double inverse is the identity
claim inverse_involution: forall s. forall r. forall t. forall x. forall y.
    ((inverse(s, r) & inverse(t, s)) -> (rel_elem(t, x, y) <-> rel_elem(r, x, y)))

# ============================================================
# Image Claims
# ============================================================

# Elimination: element of the image has a preimage in a
claim image_elem: forall t. forall r. forall a. forall y.
    ((image(t, r, a) & elem(y, t)) -> exists x. (elem(x, a) & rel_elem(r, x, y)))

# Introduction: if x is in a and (x,y) is in r, then y is in the image
claim image_intro: forall t. forall r. forall a. forall x. forall y.
    ((image(t, r, a) & elem(x, a) & rel_elem(r, x, y)) -> elem(y, t))

# Image is unique
claim image_unique: forall t1. forall t2. forall r. forall a.
    ((image(t1, r, a) & image(t2, r, a)) -> eq(t1, t2))

# ============================================================
# Relation Extensionality
# ============================================================

# Relation extensionality: same rel_elem everywhere → equal as sets
claim rel_ext: forall r. forall s.
    ((is_relation(r) & is_relation(s) &
      forall a. forall b. (rel_elem(r, a, b) <-> rel_elem(s, a, b))) -> eq(r, s))

# ============================================================
# Binary Relation Properties (Note 3.44)
# ============================================================
#
# A binary relation ≺ ⊆ X² can have various structural properties.
# In our formalization, rel_elem(r, a, b) represents a ≺ b.

# reflexive(r, x): every element is related to itself
@def(reflexive) axiom reflexive_def: forall r. forall x.
    (reflexive(r, x) <-> forall a. (elem(a, x) -> rel_elem(r, a, a)))

# irreflexive(r, x): no element is related to itself
@def(irreflexive) axiom irreflexive_def: forall r. forall x.
    (irreflexive(r, x) <-> forall a. (elem(a, x) -> ~rel_elem(r, a, a)))

# symmetric_rel(r, x): a ≺ b implies b ≺ a
@def(symmetric_rel) axiom symmetric_rel_def: forall r. forall x.
    (symmetric_rel(r, x) <-> forall a. forall b.
        ((elem(a, x) & elem(b, x) & rel_elem(r, a, b)) -> rel_elem(r, b, a)))

# antisymmetric(r, x): a ≺ b and b ≺ a implies a = b
@def(antisymmetric) axiom antisymmetric_def: forall r. forall x.
    (antisymmetric(r, x) <-> forall a. forall b.
        ((elem(a, x) & elem(b, x) & rel_elem(r, a, b) & rel_elem(r, b, a)) ->
         eq(a, b)))

# transitive_rel(r, x): a ≺ b and b ≺ c implies a ≺ c
@def(transitive_rel) axiom transitive_rel_def: forall r. forall x.
    (transitive_rel(r, x) <-> forall a. forall b. forall c.
        ((elem(a, x) & elem(b, x) & elem(c, x) &
          rel_elem(r, a, b) & rel_elem(r, b, c)) ->
         rel_elem(r, a, c)))

# trichotomous(r, x): at least one of a≺b, a=b, b≺a holds
@def(trichotomous) axiom trichotomous_def: forall r. forall x.
    (trichotomous(r, x) <-> forall a. forall b.
        ((elem(a, x) & elem(b, x)) ->
         (rel_elem(r, a, b) | eq(a, b) | rel_elem(r, b, a))))

# ============================================================
# Compound Relation Types (Note 3.44)
# ============================================================

# preorder(r, x): reflexive and transitive
@def(preorder) axiom preorder_def: forall r. forall x.
    (preorder(r, x) <-> (reflexive(r, x) & transitive_rel(r, x)))

# partial_order(r, x): antisymmetric preorder
@def(partial_order) axiom partial_order_def: forall r. forall x.
    (partial_order(r, x) <-> (antisymmetric(r, x) & preorder(r, x)))

# linear_order(r, x): trichotomous partial order
@def(linear_order) axiom linear_order_def: forall r. forall x.
    (linear_order(r, x) <-> (trichotomous(r, x) & partial_order(r, x)))

# equivalence_relation(r, x): symmetric preorder
@def(equivalence_relation) axiom equivalence_relation_def: forall r. forall x.
    (equivalence_relation(r, x) <-> (symmetric_rel(r, x) & preorder(r, x)))

# graph(r, x): symmetric and irreflexive (simple undirected graph)
@def(graph) axiom graph_def: forall r. forall x.
    (graph(r, x) <-> (symmetric_rel(r, x) & irreflexive(r, x)))

# ============================================================
# Preorder Claims
# ============================================================

claim preorder_reflexive: forall r. forall x.
    (preorder(r, x) -> reflexive(r, x))

claim preorder_transitive: forall r. forall x.
    (preorder(r, x) -> transitive_rel(r, x))

claim preorder_intro: forall r. forall x.
    ((reflexive(r, x) & transitive_rel(r, x)) -> preorder(r, x))

# ============================================================
# Partial Order Claims
# ============================================================

claim partial_order_antisymmetric: forall r. forall x.
    (partial_order(r, x) -> antisymmetric(r, x))

claim partial_order_preorder: forall r. forall x.
    (partial_order(r, x) -> preorder(r, x))

claim partial_order_reflexive: forall r. forall x.
    (partial_order(r, x) -> reflexive(r, x))

claim partial_order_transitive: forall r. forall x.
    (partial_order(r, x) -> transitive_rel(r, x))

claim partial_order_intro: forall r. forall x.
    ((antisymmetric(r, x) & preorder(r, x)) -> partial_order(r, x))

# ============================================================
# Linear Order Claims
# ============================================================

claim linear_order_trichotomous: forall r. forall x.
    (linear_order(r, x) -> trichotomous(r, x))

claim linear_order_partial_order: forall r. forall x.
    (linear_order(r, x) -> partial_order(r, x))

claim linear_order_intro: forall r. forall x.
    ((trichotomous(r, x) & partial_order(r, x)) -> linear_order(r, x))

# ============================================================
# Equivalence Relation Claims
# ============================================================

claim equivalence_symmetric: forall r. forall x.
    (equivalence_relation(r, x) -> symmetric_rel(r, x))

claim equivalence_preorder: forall r. forall x.
    (equivalence_relation(r, x) -> preorder(r, x))

claim equivalence_reflexive: forall r. forall x.
    (equivalence_relation(r, x) -> reflexive(r, x))

claim equivalence_transitive: forall r. forall x.
    (equivalence_relation(r, x) -> transitive_rel(r, x))

claim equivalence_intro: forall r. forall x.
    ((symmetric_rel(r, x) & preorder(r, x)) -> equivalence_relation(r, x))

# ============================================================
# Graph Claims
# ============================================================

claim graph_symmetric: forall r. forall x.
    (graph(r, x) -> symmetric_rel(r, x))

claim graph_irreflexive: forall r. forall x.
    (graph(r, x) -> irreflexive(r, x))

claim graph_intro: forall r. forall x.
    ((symmetric_rel(r, x) & irreflexive(r, x)) -> graph(r, x))
