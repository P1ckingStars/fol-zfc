    h_irr = and_elim_r h_body
    h_impl = implies_intro h_irr
    h2 = forall_intro h_impl
    h1 = forall_intro h2
    qed h1

proof graph_intro:
    fix r
    fix x
    h = assume symmetric_rel(r, x) & irreflexive(r, x)
    gd = use graph_def
    gd1 = forall_elim gd, r
    gd2 = forall_elim gd1, x
    h_gr = iff_elim_r gd2, h
    h_impl = implies_intro h_gr
    h2 = forall_intro h_impl
    h1 = forall_intro h2
    qed h1
