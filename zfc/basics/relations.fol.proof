proof graph_symmetric:
    fix r
    fix x
    h = assume graph(r, x)
    gd = use graph_def
    gd1 = forall_elim gd, r
    gd2 = forall_elim gd1, x
    h_body = iff_elim_l gd2, h
    h_sym = and_elim_l h_body
    h_impl = implies_intro h_sym
    h2 = forall_intro h_impl
    h1 = forall_intro h2
    qed h1

proof graph_irreflexive:
    fix r
    fix x
