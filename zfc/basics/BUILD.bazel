load("//build:fol.bzl", "fol_library", "fol_proof")

package(default_visibility = ["//visibility:public"])

# Legacy exports for tests that still use load_file_recursive
exports_files([
    "axioms.fol",
    "functions.fol",
    "ordered_pair.fol",
    "replacement_choice.fol",
    "test.fol",
    "axioms.fol.def",
    "ordered_pair.fol.def",
    "ordered_pair.fol.proof",
    "functions.fol.def",
    "functions.fol.proof",
    "replacement_choice.fol.def",
])

# ============================================================
# FOL Libraries (axioms + claims, no proofs)
# ============================================================

fol_library(
    name = "axioms",
    header = "axioms.fol.def",
)

fol_library(
    name = "ordered_pair_lib",
    header = "ordered_pair.fol.def",
    deps = [":axioms"],
)

fol_library(
    name = "functions_lib",
    header = "functions.fol.def",
    deps = [":ordered_pair_lib"],
)

fol_library(
    name = "subset_lib",
    header = "subset.fol.def",
    deps = [":axioms"],
)

fol_library(
    name = "replacement_choice_lib",
    header = "replacement_choice.fol.def",
    deps = [":functions_lib"],
)

# ============================================================
# FOL Proofs (verify all claims are proved)
# ============================================================

fol_proof(
    name = "ordered_pair",
    header = "ordered_pair.fol.def",
    proof = "ordered_pair.fol.proof",
    deps = [":axioms"],
)

fol_proof(
    name = "functions",
    header = "functions.fol.def",
    proof = "functions.fol.proof",
    deps = [":ordered_pair"],
)

fol_proof(
    name = "subset",
    header = "subset.fol.def",
    proof = "subset.fol.proof",
    deps = [":axioms"],
)
