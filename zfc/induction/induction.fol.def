include "../basics/functions.fol.def"
include "../basics/subset.fol.def"

# ============================================================
# Monotone Set Operators
# ============================================================
#
# A monotone operator is a function that preserves the subset
# ordering: A ⊆ B implies F(A) ⊆ F(B).

# monotone(f) means f is a monotone function on sets
@def(monotone) axiom monotone_def: forall f.
    (monotone(f) <->
        (is_function(f) &
         forall a. forall b. (subset(a, b) ->
             forall fa. forall fb. ((rel_elem(f, a, fa) & rel_elem(f, b, fb)) ->
                 subset(fa, fb)))))

# ============================================================
# F-Closed Sets and Least Fixed Point
# ============================================================
#
# A set C is F-closed if F(C) ⊆ C. The least fixed point
# (inductive set) over base b is the smallest F-closed set
# containing b: an element belongs to the lfp iff it belongs
# to every F-closed set that contains b.

# closed(f, c) means c is an F-closed set: F(c) ⊆ c
@def(closed) axiom closed_def: forall f. forall c.
    (closed(f, c) <-> forall fc. (rel_elem(f, c, fc) -> subset(fc, c)))

# lfp(l, f, b) means l is the smallest F-closed set containing b
@def(lfp) axiom lfp_def: forall l. forall f. forall b.
    (lfp(l, f, b) <->
        forall x. (elem(x, l) <->
            forall c. ((closed(f, c) & subset(b, c)) -> elem(x, c))))

# ============================================================
# Claims
# ============================================================

# The lfp contains the base set
claim lfp_contains_base: forall l. forall f. forall b.
    (lfp(l, f, b) -> subset(b, l))

# The lfp is a subset of every F-closed set containing the base
claim lfp_subset_closed: forall l. forall f. forall b. forall c.
    ((lfp(l, f, b) & closed(f, c) & subset(b, c)) -> subset(l, c))
