include "../basics/functions.fol.def"
include "../basics/subset.fol.def"

# ============================================================
# Monotone Set Operators
# ============================================================
#
# A monotone operator is a function F: P(S) -> P(S) that
# preserves the subset ordering: A ⊆ B implies F(A) ⊆ F(B).

# monotone(f, s) means f is a monotone operator on P(s)
@def(monotone) axiom monotone_def: forall f. forall s.
    (monotone(f, s) <->
        (is_function(f) &
         forall a. forall b. ((subset(a, s) & subset(b, s) & subset(a, b)) ->
             forall fa. forall fb. ((rel_elem(f, a, fa) & rel_elem(f, b, fb)) ->
                 subset(fa, fb)))))

# ============================================================
# F-Closed Sets and Least Fixed Point
# ============================================================
#
# A set C ⊆ S is F-closed if F(C) ⊆ C. The least fixed point
# (inductive set) is the intersection of all F-closed subsets
# of S: an element belongs to the lfp iff it belongs to every
# F-closed set.

# closed(f, c, s) means c is an F-closed subset of s
@def(closed) axiom closed_def: forall f. forall c. forall s.
    (closed(f, c, s) <->
        (subset(c, s) &
         forall fc. (rel_elem(f, c, fc) -> subset(fc, c))))

# lfp(l, f, s) means l is the least fixed point of f on s
@def(lfp) axiom lfp_def: forall l. forall f. forall s.
    (lfp(l, f, s) <->
        forall x. (elem(x, l) <->
            forall c. (closed(f, c, s) -> elem(x, c))))

# ============================================================
# Claims
# ============================================================

# An F-closed set is a subset of s
claim closed_is_subset: forall f. forall c. forall s.
    (closed(f, c, s) -> subset(c, s))

# The lfp is a subset of every F-closed set
claim lfp_subset_closed: forall l. forall f. forall s. forall c.
    ((lfp(l, f, s) & closed(f, c, s)) -> subset(l, c))
