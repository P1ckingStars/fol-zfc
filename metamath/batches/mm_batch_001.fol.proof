# intnan
proof mm_intnan:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_intnan_1 = assume ~elem(u0, S_ph)
    h1 = use mm_simpr
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = use wff_and
    h6 = forall_elim h5, S_ps
    h7 = forall_elim h6, S_ph
    h9 = iota_elim h7, h8_w
