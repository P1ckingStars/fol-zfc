# jarri
proof mm_jarri:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_jarri_1 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> elem(u0, S_ch))
    h1 = assume elem(u0, S_ps)
    h2 = assume elem(u0, S_ph)
    h3 = and_intro h1, h2
    h4 = and_elim_l h3
    h5 = implies_intro h4
    h6 = implies_intro h5
    h7 = use wff_impl
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ps
    h11 = exists_elim h9, h10_w
    h12 = forall_elim h11, u0
    h13 = use mm_syl
    h14 = forall_elim h13, S_ps
    h15 = forall_elim h14, h10_w
    h16 = forall_elim h15, S_ch
    h17 = forall_elim h16, u0
    h18 = assume elem(u0, S_ps)
    h19 = implies_elim h6, h18
    h20 = iff_elim_r h12, h19
    h21 = implies_intro h20
    h22 = implies_elim h17, h21
    h23 = assume elem(u0, h10_w)
    h24 = iff_elim_l h12, h23
    h25 = implies_elim hyp_mm_jarri_1, h24
    h26 = implies_intro h25
    h27 = implies_elim h22, h26
    h28 = exists_intro h27
    h29 = and_intro hyp_mm_jarri_1, h28
    h30 = and_elim_r h29
    h31 = implies_intro h30
    h32 = assume (((elem(u0, S_ph) -> elem(u0, S_ps)) -> elem(u0, S_ch)) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h33 = implies_intro h32
    h34 = implies_elim h33, h31
    h35 = forall_intro h34
    h36 = forall_intro h35
    h37 = forall_intro h36
    h38 = forall_intro h37
    qed h38

