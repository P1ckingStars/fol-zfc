# notnotb
proof mm_notnotb:
    fix S_ph
    fix u0
    h1 = use mm_notnot
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, u0
    h4 = use mm_notnotr
    h5 = forall_elim h4, S_ph
    h6 = forall_elim h5, u0
    h7 = use wff_neg
    h8 = forall_elim h7, S_ph
    h10 = iota_elim h8, h9_w
    h11 = use wff_neg
    h12 = forall_elim h11, h9_w
    h14 = iota_elim h12, h13_w
    fix _ncv15
    h16 = forall_elim h14, _ncv15
    h17 = forall_elim h10, _ncv15
    h18 = assume elem(_ncv15, h13_w)
    h19 = iff_elim_l h16, h18
    h20 = assume ~elem(_ncv15, S_ph)
    h21 = iff_elim_r h17, h20
    h22 = not_elim h19, h21
    h23 = not_intro h22
    h24 = implies_intro h23
    h25 = assume ~ ~elem(_ncv15, S_ph)
    h26 = assume elem(_ncv15, h9_w)
    h27 = iff_elim_l h17, h26
    h28 = not_elim h25, h27
    h29 = not_intro h28
    h30 = iff_elim_r h16, h29
    h31 = implies_intro h30
    h32 = iff_intro h24, h31
    h33 = forall_intro h32
    h34 = use mm_impbii
    h35 = forall_elim h34, S_ph
    h36 = forall_elim h35, h13_w
    h37 = forall_elim h36, u0
    h38 = assume elem(u0, S_ph)
    h39 = implies_elim h3, h38
    h40 = forall_elim h33, u0
    h41 = iff_elim_r h40, h39
    h42 = implies_intro h41
    h43 = implies_elim h37, h42
    h44 = assume elem(u0, h13_w)
    h45 = forall_elim h33, u0
    h46 = iff_elim_l h45, h44
    h47 = implies_elim h6, h46
    h48 = implies_intro h47
    h49 = implies_elim h43, h48
    h50 = assume elem(u0, S_ph)
    h51 = iff_elim_l h49, h50
    h52 = forall_elim h33, u0
    h53 = iff_elim_l h52, h51
    h54 = implies_intro h53
    h55 = assume ~ ~elem(u0, S_ph)
    h56 = forall_elim h33, u0
    h57 = iff_elim_r h56, h55
    h58 = iff_elim_r h49, h57
    h59 = implies_intro h58
    h60 = iff_intro h54, h59
    h61 = assume (elem(u0, S_ph) <-> ~ ~elem(u0, S_ph))
    h62 = implies_intro h61
    h63 = implies_elim h62, h60
    h64 = forall_intro h63
    h65 = forall_intro h64
    qed h65

# con34b
proof mm_con34b:
    fix S_ph
    fix S_ps
    fix u0
    h1 = use mm_con3
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = use mm_con4
    h6 = forall_elim h5, S_ps
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, u0
    h9 = use wff_impl
    h10 = forall_elim h9, S_ph
    h11 = forall_elim h10, S_ps
    h13 = iota_elim h11, h12_w
    h14 = use wff_neg
    h15 = forall_elim h14, S_ps
    h17 = iota_elim h15, h16_w
    h18 = use wff_neg
    h19 = forall_elim h18, S_ph
    h21 = iota_elim h19, h20_w
    h22 = use wff_impl
    h23 = forall_elim h22, h16_w
    h24 = forall_elim h23, h20_w
    h26 = iota_elim h24, h25_w
    fix _bcv27
    h28 = forall_elim h26, _bcv27
    h29 = forall_elim h17, _bcv27
    h30 = forall_elim h21, _bcv27
    h31 = assume elem(_bcv27, h25_w)
    h32 = iff_elim_l h28, h31
    h33 = assume ~elem(_bcv27, S_ps)
    h34 = iff_elim_r h29, h33
    h35 = implies_elim h32, h34
    h36 = iff_elim_l h30, h35
    h37 = implies_intro h36
    h38 = implies_intro h37
    h39 = assume (~elem(_bcv27, S_ps) -> ~elem(_bcv27, S_ph))
    h40 = assume elem(_bcv27, h16_w)
    h41 = iff_elim_l h29, h40
    h42 = implies_elim h39, h41
    h43 = iff_elim_r h30, h42
    h44 = implies_intro h43
    h45 = iff_elim_r h28, h44
    h46 = implies_intro h45
    h47 = iff_intro h38, h46
    h48 = forall_intro h47
    h49 = use mm_impbii
    h50 = forall_elim h49, h12_w
    h51 = forall_elim h50, h25_w
    h52 = forall_elim h51, u0
    h53 = assume elem(u0, h12_w)
    h54 = forall_elim h13, u0
    h55 = iff_elim_l h54, h53
    h56 = implies_elim h4, h55
    h57 = forall_elim h48, u0
    h58 = iff_elim_r h57, h56
    h59 = implies_intro h58
    h60 = implies_elim h52, h59
    h61 = assume elem(u0, h25_w)
    h62 = forall_elim h48, u0
    h63 = iff_elim_l h62, h61
    h64 = implies_elim h8, h63
    h65 = forall_elim h13, u0
    h66 = iff_elim_r h65, h64
    h67 = implies_intro h66
    h68 = implies_elim h60, h67
    h69 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h70 = forall_elim h13, u0
    h71 = iff_elim_r h70, h69
    h72 = iff_elim_l h68, h71
    h73 = forall_elim h48, u0
    h74 = iff_elim_l h73, h72
    h75 = implies_intro h74
    h76 = assume (~elem(u0, S_ps) -> ~elem(u0, S_ph))
    h77 = forall_elim h48, u0
    h78 = iff_elim_r h77, h76
    h79 = iff_elim_r h68, h78
    h80 = forall_elim h13, u0
    h81 = iff_elim_l h80, h79
    h82 = implies_intro h81
    h83 = iff_intro h75, h82
    h84 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) <-> (~elem(u0, S_ps) -> ~elem(u0, S_ph)))
    h85 = implies_intro h84
    h86 = implies_elim h85, h83
    h87 = forall_intro h86
    h88 = forall_intro h87
    h89 = forall_intro h88
    qed h89

# con4bid
proof mm_con4bid:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_con4bid_1 = assume (elem(u0, S_ph) -> (~elem(u0, S_ps) <-> ~elem(u0, S_ch)))
    h1 = use wff_neg
    h2 = forall_elim h1, S_ps
    h4 = iota_elim h2, h3_w
    h5 = use wff_neg
    h6 = forall_elim h5, S_ch
    h8 = iota_elim h6, h7_w
    h9 = use mm_biimprd
    h10 = forall_elim h9, S_ph
    h11 = forall_elim h10, h3_w
    h12 = forall_elim h11, h7_w
    h13 = forall_elim h12, u0
    h14 = assume elem(u0, S_ph)
    h15 = implies_elim hyp_mm_con4bid_1, h14
    h16 = assume elem(u0, h3_w)
    h17 = forall_elim h4, u0
    h18 = iff_elim_l h17, h16
    h19 = iff_elim_l h15, h18
    h20 = forall_elim h8, u0
    h21 = iff_elim_r h20, h19
    h22 = implies_intro h21
    h23 = assume elem(u0, h7_w)
    h24 = forall_elim h8, u0
    h25 = iff_elim_l h24, h23
    h26 = iff_elim_r h15, h25
    h27 = forall_elim h4, u0
    h28 = iff_elim_r h27, h26
    h29 = implies_intro h28
    h30 = iff_intro h22, h29
    h31 = implies_intro h30
    h32 = implies_elim h13, h31
    h33 = assume elem(u0, S_ph)
