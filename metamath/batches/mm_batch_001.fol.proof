# con4
proof mm_con4:
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume ~elem(u0, S_ph) -> ~elem(u0, S_ps)
    h2 = assume elem(u0, S_ps)
    h3 = assume ~elem(u0, S_ph)
    h4 = implies_elim h1, h3
    h5 = not_elim h4, h2
    h6 = not_intro h5
    h7 = double_neg_elim h6
    h8 = implies_intro h7
    h9 = implies_intro h8
    h10 = assume ((~elem(u0, S_ph) -> ~elem(u0, S_ps)) -> (elem(u0, S_ps) -> elem(u0, S_ph)))
    h11 = implies_intro h10
    h12 = implies_elim h11, h9
    h13 = forall_intro h12
    h14 = forall_intro h13
    h15 = forall_intro h14
    qed h15

