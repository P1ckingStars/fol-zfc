    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    h1 = use mm_simpr
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = use wff_and
    h6 = forall_elim h5, S_ph
    h7 = forall_elim h6, S_ps
    h9 = exists_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_olcd
    h12 = forall_elim h11, h8_w
    h13 = forall_elim h12, S_ps
    h14 = forall_elim h13, S_ch
    h15 = forall_elim h14, u0
    h16 = assume elem(u0, h8_w)
    h17 = iff_elim_l h10, h16
    h18 = implies_elim h4, h17
    h19 = implies_intro h18
    h20 = implies_elim h15, h19
    h21 = assume (elem(u0, S_ph) & elem(u0, S_ps))
    h22 = iff_elim_r h10, h21
    h23 = implies_elim h20, h22
    h24 = implies_intro h23
    h25 = exists_intro h24
    h26 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) -> (elem(u0, S_ch) | elem(u0, S_ps)))
    h27 = implies_intro h26
    h28 = implies_elim h27, h25
    h29 = forall_intro h28
    h30 = forall_intro h29
    h31 = forall_intro h30
    h32 = forall_intro h31
    qed h32

