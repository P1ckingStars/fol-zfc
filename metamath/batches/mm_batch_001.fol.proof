    h11 = forall_elim h10, h8_w
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, u0
    h14 = implies_elim h13, hyp_mm_intnan_1
    h15 = assume elem(u0, h8_w)
    h16 = forall_elim h9, u0
    h17 = iff_elim_l h16, h15
    h18 = implies_elim h4, h17
    h19 = implies_intro h18
    h20 = implies_elim h14, h19
    h21 = assume (elem(u0, S_ps) & elem(u0, S_ph))
    h22 = forall_elim h9, u0
    h23 = iff_elim_r h22, h21
    h24 = not_elim h20, h23
    h25 = not_intro h24
    h26 = and_intro hyp_mm_intnan_1, h25
    h27 = and_elim_r h26
    h28 = implies_intro h27
    h29 = assume (~elem(u0, S_ph) -> ~(elem(u0, S_ps) & elem(u0, S_ph)))
    h30 = implies_intro h29
    h31 = implies_elim h30, h28
    h32 = forall_intro h31
    h33 = forall_intro h32
    h34 = forall_intro h33
    qed h34

