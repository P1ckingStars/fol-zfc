# nfnf
proof mm_nfnf:
    fix x
    fix y
    fix S_ph
    fix u0
    hyp_mm_nfnf_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    h1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    h2 = implies_intro h1
    h3 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = use mm_nfex
    h7 = forall_elim h6, x
    h8 = forall_elim h7, y
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, hyp_mm_nfnf_1
    h12 = use mm_nfal
    h13 = forall_elim h12, x
    h14 = forall_elim h13, y
    h15 = forall_elim h14, S_ph
    h16 = forall_elim h15, u0
    h17 = implies_elim h16, hyp_mm_nfnf_1
    h18 = use mm_nfim
    h19 = forall_elim h18, x
    h20 = forall_elim h19, S_ph
    h21 = forall_elim h20, S_ph
    h22 = forall_elim h21, u0
    h23 = implies_elim h22, h11
    h24 = implies_elim h23, h17
    h25 = use wff_impl
    h26 = forall_elim h25, S_ph
    h27 = forall_elim h26, S_ph
    h29 = iota_elim h27, h28_w
    h30 = use wff_impl
    h31 = forall_elim h30, S_ph
    h32 = forall_elim h31, S_ph
    h34 = iota_elim h32, h33_w
    h35 = use mm_nfxfr
    h36 = forall_elim h35, x
    h37 = forall_elim h36, h28_w
    h38 = forall_elim h37, h33_w
    h39 = forall_elim h38, u0
    h40 = assume elem(u0, h28_w)
    h41 = forall_elim h29, u0
    h42 = iff_elim_l h41, h40
    h43 = iff_elim_l h5, h42
    h44 = forall_elim h34, u0
    h45 = iff_elim_r h44, h43
    h46 = implies_intro h45
    h47 = assume elem(u0, h33_w)
    h48 = forall_elim h34, u0
    h49 = iff_elim_l h48, h47
    h50 = iff_elim_r h5, h49
    h51 = forall_elim h29, u0
    h52 = iff_elim_r h51, h50
    h53 = implies_intro h52
    h54 = iff_intro h46, h53
    h55 = implies_elim h39, h54
    h56 = assume elem(u0, h33_w)
    h57 = forall_elim h34, u0
    h58 = iff_elim_l h57, h56
    h59 = implies_elim h24, h58
    h60 = forall_elim h34, u0
    h61 = iff_elim_r h60, h59
    h62 = implies_intro h61
    h63 = implies_elim h55, h62
    h64 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    h65 = forall_elim h29, u0
    h66 = iff_elim_r h65, h64
    h67 = implies_elim h63, h66
    h68 = forall_elim h29, u0
    h69 = iff_elim_l h68, h67
    h70 = implies_intro h69
    h71 = and_intro hyp_mm_nfnf_1, h70
    h72 = and_elim_r h71
    h73 = implies_intro h72
    h74 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ph) -> elem(u0, S_ph)) -> (elem(u0, S_ph) -> elem(u0, S_ph))))
    h75 = implies_intro h74
    h76 = implies_elim h75, h73
    h77 = forall_intro h76
    h78 = forall_intro h77
    h79 = forall_intro h78
    h80 = forall_intro h79
    qed h80

