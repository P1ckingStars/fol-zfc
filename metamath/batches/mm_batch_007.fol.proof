    h17 = forall_elim h16, h13_w
    h18 = forall_elim h17, S_ph
    h19 = forall_elim h18, u0
    h20 = assume elem(u0, h8_w)
    h21 = forall_elim h9, u0
    h22 = iff_elim_l h21, h20
    h23 = iff_elim_l h4, h22
    h24 = forall_elim h14, u0
    h25 = iff_elim_r h24, h23
    h26 = implies_intro h25
    h27 = assume elem(u0, h13_w)
    h28 = forall_elim h14, u0
    h29 = iff_elim_l h28, h27
    h30 = iff_elim_r h4, h29
    h31 = forall_elim h9, u0
    h32 = iff_elim_r h31, h30
    h33 = implies_intro h32
    h34 = iff_intro h26, h33
    h35 = implies_elim h19, h34
    h36 = assume elem(u0, h13_w)
    h37 = forall_elim h14, u0
    h38 = iff_elim_l h37, h36
    h39 = implies_elim hyp_mm_eqcoms_1, h38
    h40 = implies_intro h39
    h41 = implies_elim h35, h40
    h42 = assume eq(B, A)
    h43 = forall_elim h9, u0
    h44 = iff_elim_r h43, h42
    h45 = implies_elim h41, h44
    h46 = implies_intro h45
    h47 = and_intro hyp_mm_eqcoms_1, h46
    h48 = and_elim_r h47
    h49 = implies_intro h48
    h50 = assume ((eq(A, B) -> elem(u0, S_ph)) -> (eq(B, A) -> elem(u0, S_ph)))
    h51 = implies_intro h50
    h52 = implies_elim h51, h49
    h53 = forall_intro h52
    h54 = forall_intro h53
    h55 = forall_intro h54
    h56 = forall_intro h55
    qed h56

