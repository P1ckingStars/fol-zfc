    h14 = use wff_neg
    h15 = forall_elim h14, h12_w
    h17 = iota_elim h15, h16_w
    fix _ncv18
    h19 = forall_elim h17, _ncv18
    h20 = forall_elim h13, _ncv18
    h21 = assume elem(_ncv18, h16_w)
    h22 = iff_elim_l h19, h21
    h23 = assume eq(A, B)
    h24 = iff_elim_r h20, h23
    h25 = not_elim h22, h24
    h26 = not_intro h25
    h27 = implies_intro h26
    h28 = assume ~eq(A, B)
    h29 = assume elem(_ncv18, h12_w)
    h30 = iff_elim_l h20, h29
    h31 = not_elim h28, h30
    h32 = not_intro h31
    h33 = iff_elim_r h19, h32
    h34 = implies_intro h33
    h35 = iff_intro h27, h34
    h36 = forall_intro h35
    h37 = use mm_mpbir
    h38 = forall_elim h37, h7_w
    h39 = forall_elim h38, h16_w
    h40 = forall_elim h39, u0
    h41 = forall_elim h36, u0
    h42 = iff_elim_r h41, hyp_mm_neir_1
    h43 = implies_elim h40, h42
    h44 = assume elem(u0, h7_w)
    h45 = forall_elim h8, u0
    h46 = iff_elim_l h45, h44
    h47 = iff_elim_l h3, h46
    h48 = forall_elim h36, u0
    h49 = iff_elim_r h48, h47
    h50 = implies_intro h49
    h51 = assume elem(u0, h16_w)
    h52 = forall_elim h36, u0
    h53 = iff_elim_l h52, h51
    h54 = iff_elim_r h3, h53
    h55 = forall_elim h8, u0
    h56 = iff_elim_r h55, h54
