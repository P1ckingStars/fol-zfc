# Translated from Metamath set.mm

# mpbiran2
proof mm_mpbiran2:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mpbiran2_1 = assume elem(u0, S_ch)
    hyp_mm_mpbiran2_2 = assume (elem(u0, S_ph) <-> (elem(u0, S_ps) & elem(u0, S_ch)))
    h1 = use mm_biancomi
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ch
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_mpbiran2_2
    h7 = use mm_mpbiran
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, S_ps
    h11 = forall_elim h10, u0
    h12 = implies_elim h11, hyp_mm_mpbiran2_1
    h13 = implies_elim h12, h6
    h14 = and_intro hyp_mm_mpbiran2_2, h13
    h15 = and_elim_r h14
    h16 = implies_intro h15
    h17 = and_intro hyp_mm_mpbiran2_1, h16
    h18 = and_elim_r h17
    h19 = implies_intro h18
    h20 = assume (elem(u0, S_ch) -> ((elem(u0, S_ph) <-> (elem(u0, S_ps) & elem(u0, S_ch))) -> (elem(u0, S_ph) <-> elem(u0, S_ps))))
    h21 = implies_intro h20
    h22 = implies_elim h21, h19
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    h26 = forall_intro h25
    qed h26

# mpbir2an
proof mm_mpbir2an:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mpbir2an_1 = assume elem(u0, S_ps)
    hyp_mm_mpbir2an_2 = assume elem(u0, S_ch)
    hyp_mm_mpbir2an_maj = assume (elem(u0, S_ph) <-> (elem(u0, S_ps) & elem(u0, S_ch)))
    h1 = use mm_mpbiran
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_mpbir2an_1
    h7 = implies_elim h6, hyp_mm_mpbir2an_maj
    h8 = use mm_mpbir
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, S_ch
    h11 = forall_elim h10, u0
    h12 = implies_elim h11, hyp_mm_mpbir2an_2
    h13 = implies_elim h12, h7
    h14 = and_intro hyp_mm_mpbir2an_maj, h13
    h15 = and_elim_r h14
    h16 = implies_intro h15
    h17 = and_intro hyp_mm_mpbir2an_2, h16
    h18 = and_elim_r h17
    h19 = implies_intro h18
    h20 = and_intro hyp_mm_mpbir2an_1, h19
    h21 = and_elim_r h20
    h22 = implies_intro h21
    h23 = assume (elem(u0, S_ps) -> (elem(u0, S_ch) -> ((elem(u0, S_ph) <-> (elem(u0, S_ps) & elem(u0, S_ch))) -> elem(u0, S_ph))))
    h24 = implies_intro h23
    h25 = implies_elim h24, h22
    h26 = forall_intro h25
    h27 = forall_intro h26
    h28 = forall_intro h27
    h29 = forall_intro h28
    qed h29

# mpbi2and
proof mm_mpbi2and:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_mpbi2and_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_mpbi2and_2 = assume (elem(u0, S_ph) -> elem(u0, S_ch))
    hyp_mm_mpbi2and_3 = assume (elem(u0, S_ph) -> ((elem(u0, S_ps) & elem(u0, S_ch)) <-> elem(u0, S_th)))
    h1 = use mm_jca
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_mpbi2and_1
    h7 = implies_elim h6, hyp_mm_mpbi2and_2
    h8 = use wff_and
    h9 = forall_elim h8, S_ps
    h10 = forall_elim h9, S_ch
    h12 = exists_elim h10, h11_w
    h13 = forall_elim h12, u0
    h14 = use mm_mpbid
    h15 = forall_elim h14, S_ph
    h16 = forall_elim h15, h11_w
    h17 = forall_elim h16, S_th
    h18 = forall_elim h17, u0
    h19 = assume elem(u0, S_ph)
    h20 = implies_elim h7, h19
    h21 = iff_elim_r h13, h20
    h22 = implies_intro h21
    h23 = implies_elim h18, h22
    h24 = assume elem(u0, S_ph)
    h25 = implies_elim hyp_mm_mpbi2and_3, h24
    h26 = assume elem(u0, h11_w)
    h27 = iff_elim_l h13, h26
    h28 = iff_elim_l h25, h27
    h29 = implies_intro h28
    h30 = assume elem(u0, S_th)
    h31 = iff_elim_r h25, h30
    h32 = iff_elim_r h13, h31
    h33 = implies_intro h32
    h34 = iff_intro h29, h33
    h35 = implies_intro h34
    h36 = implies_elim h23, h35
    h37 = exists_intro h36
    h38 = and_intro hyp_mm_mpbi2and_3, h37
    h39 = and_elim_r h38
    h40 = implies_intro h39
    h41 = and_intro hyp_mm_mpbi2and_2, h40
    h42 = and_elim_r h41
    h43 = implies_intro h42
    h44 = and_intro hyp_mm_mpbi2and_1, h43
    h45 = and_elim_r h44
    h46 = implies_intro h45
    h47 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ch)) -> ((elem(u0, S_ph) -> ((elem(u0, S_ps) & elem(u0, S_ch)) <-> elem(u0, S_th))) -> (elem(u0, S_ph) -> elem(u0, S_th)))))
    h48 = implies_intro h47
    h49 = implies_elim h48, h46
    h50 = forall_intro h49
    h51 = forall_intro h50
    h52 = forall_intro h51
    h53 = forall_intro h52
    h54 = forall_intro h53
    qed h54

# mpbir2and
proof mm_mpbir2and:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_mpbir2and_1 = assume (elem(u0, S_ph) -> elem(u0, S_ch))
    hyp_mm_mpbir2and_2 = assume (elem(u0, S_ph) -> elem(u0, S_th))
    hyp_mm_mpbir2and_3 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) <-> (elem(u0, S_ch) & elem(u0, S_th))))
    h1 = use mm_jca
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ch
    h4 = forall_elim h3, S_th
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_mpbir2and_1
    h7 = implies_elim h6, hyp_mm_mpbir2and_2
    h8 = use wff_and
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, S_th
    h12 = exists_elim h10, h11_w
    h13 = forall_elim h12, u0
    h14 = use mm_mpbird
    h15 = forall_elim h14, S_ph
    h16 = forall_elim h15, S_ps
    h17 = forall_elim h16, h11_w
    h18 = forall_elim h17, u0
    h19 = assume elem(u0, S_ph)
    h20 = implies_elim h7, h19
    h21 = iff_elim_r h13, h20
    h22 = implies_intro h21
    h23 = implies_elim h18, h22
    h24 = assume elem(u0, S_ph)
    h25 = implies_elim hyp_mm_mpbir2and_3, h24
    h26 = assume elem(u0, S_ps)
    h27 = iff_elim_l h25, h26
    h28 = iff_elim_r h13, h27
    h29 = implies_intro h28
    h30 = assume elem(u0, h11_w)
    h31 = iff_elim_l h13, h30
    h32 = iff_elim_r h25, h31
    h33 = implies_intro h32
    h34 = iff_intro h29, h33
    h35 = implies_intro h34
    h36 = implies_elim h23, h35
    h37 = exists_intro h36
    h38 = and_intro hyp_mm_mpbir2and_3, h37
    h39 = and_elim_r h38
    h40 = implies_intro h39
    h41 = and_intro hyp_mm_mpbir2and_2, h40
    h42 = and_elim_r h41
    h43 = implies_intro h42
    h44 = and_intro hyp_mm_mpbir2and_1, h43
    h45 = and_elim_r h44
    h46 = implies_intro h45
    h47 = assume ((elem(u0, S_ph) -> elem(u0, S_ch)) -> ((elem(u0, S_ph) -> elem(u0, S_th)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) <-> (elem(u0, S_ch) & elem(u0, S_th)))) -> (elem(u0, S_ph) -> elem(u0, S_ps)))))
    h48 = implies_intro h47
    h49 = implies_elim h48, h46
    h50 = forall_intro h49
    h51 = forall_intro h50
    h52 = forall_intro h51
    h53 = forall_intro h52
    h54 = forall_intro h53
    qed h54

# adantll
proof mm_adantll:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_adant2_1 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch))
    h1 = use mm_simpr
    h2 = forall_elim h1, S_th
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = use wff_and
    h6 = forall_elim h5, S_th
    h7 = forall_elim h6, S_ph
    h9 = exists_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_sylan
    h12 = forall_elim h11, h8_w
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, S_ps
    h15 = forall_elim h14, S_ch
    h16 = forall_elim h15, u0
    h17 = assume elem(u0, h8_w)
    h18 = iff_elim_l h10, h17
    h19 = implies_elim h4, h18
    h20 = implies_intro h19
    h21 = implies_elim h16, h20
    h22 = implies_elim h21, hyp_mm_adant2_1
    h23 = assume ((elem(u0, S_th) & elem(u0, S_ph)) & elem(u0, S_ps))
    h24 = and_elim_l h23
    h25 = iff_elim_r h10, h24
    h26 = and_elim_r h23
    h27 = and_intro h25, h26
    h28 = implies_elim h22, h27
    h29 = implies_intro h28
    h30 = exists_intro h29
    h31 = and_intro hyp_mm_adant2_1, h30
    h32 = and_elim_r h31
    h33 = implies_intro h32
    h34 = assume (((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch)) -> (((elem(u0, S_th) & elem(u0, S_ph)) & elem(u0, S_ps)) -> elem(u0, S_ch)))
    h35 = implies_intro h34
    h36 = implies_elim h35, h33
    h37 = forall_intro h36
    h38 = forall_intro h37
    h39 = forall_intro h38
    h40 = forall_intro h39
    h41 = forall_intro h40
    qed h41

