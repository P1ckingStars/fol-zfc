# neqcomd
proof mm_neqcomd:
    fix A
    fix B
    fix S_ph
    fix u0
    hyp_mm_neqcomd_1 = assume (elem(u0, S_ph) -> ~eq(A, B))
    h1 = use mm_eqcom
    h2 = forall_elim h1, A
    h3 = forall_elim h2, B
    h4 = forall_elim h3, u0
