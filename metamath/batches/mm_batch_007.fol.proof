# barbara
proof mm_barbara:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_barbara_maj = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_barbara_min = assume (elem(u0, S_ch) -> elem(u0, S_ph))
    h1 = use mm_alsyl
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ch
    h4 = forall_elim h3, S_ph
    h5 = forall_elim h4, S_ps
    h6 = forall_elim h5, u0
    h7 = use wff_impl
    h8 = forall_elim h7, S_ch
    h9 = forall_elim h8, S_ph
    h11 = iota_elim h9, h10_w
    h12 = use wff_impl
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, S_ps
    h16 = iota_elim h14, h15_w
    h17 = use wff_impl
    h18 = forall_elim h17, S_ch
    h19 = forall_elim h18, S_ps
    h21 = iota_elim h19, h20_w
    h22 = use mm_mp2an
    h23 = forall_elim h22, h10_w
    h24 = forall_elim h23, h15_w
    h25 = forall_elim h24, h20_w
    h26 = forall_elim h25, u0
    h27 = forall_elim h11, u0
    h28 = iff_elim_r h27, hyp_mm_barbara_min
    h29 = implies_elim h26, h28
    h30 = forall_elim h16, u0
    h31 = iff_elim_r h30, hyp_mm_barbara_maj
    h32 = implies_elim h29, h31
    h33 = assume (elem(u0, h10_w) & elem(u0, h15_w))
    h34 = and_elim_l h33
    h35 = forall_elim h11, u0
    h36 = iff_elim_l h35, h34
    h37 = and_elim_r h33
    h38 = forall_elim h16, u0
    h39 = iff_elim_l h38, h37
    h40 = and_intro h36, h39
    h41 = implies_elim h6, h40
    h42 = forall_elim h21, u0
    h43 = iff_elim_r h42, h41
    h44 = implies_intro h43
    h45 = implies_elim h32, h44
    h46 = forall_elim h21, u0
    h47 = iff_elim_l h46, h45
    h48 = and_intro hyp_mm_barbara_min, h47
    h49 = and_elim_r h48
    h50 = implies_intro h49
    h51 = and_intro hyp_mm_barbara_maj, h50
    h52 = and_elim_r h51
    h53 = implies_intro h52
    h54 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ch) -> elem(u0, S_ph)) -> (elem(u0, S_ch) -> elem(u0, S_ps))))
    h55 = implies_intro h54
    h56 = implies_elim h55, h53
    h57 = forall_intro h56
    h58 = forall_intro h57
    h59 = forall_intro h58
    h60 = forall_intro h59
    h61 = forall_intro h60
    qed h61

# celarent
proof mm_celarent:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_celarent_maj = assume (elem(u0, S_ph) -> ~elem(u0, S_ps))
    hyp_mm_celarent_min = assume (elem(u0, S_ch) -> elem(u0, S_ph))
    h1 = use wff_neg
    h2 = forall_elim h1, S_ps
    h4 = iota_elim h2, h3_w
    h5 = use mm_barbara
    h6 = forall_elim h5, x
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, h3_w
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, u0
    h11 = assume elem(u0, S_ph)
    h12 = implies_elim hyp_mm_celarent_maj, h11
    h13 = forall_elim h4, u0
    h14 = iff_elim_r h13, h12
    h15 = implies_intro h14
    h16 = implies_elim h10, h15
    h17 = implies_elim h16, hyp_mm_celarent_min
    h18 = assume elem(u0, S_ch)
    h19 = implies_elim h17, h18
    h20 = forall_elim h4, u0
    h21 = iff_elim_l h20, h19
    h22 = implies_intro h21
    h23 = and_intro hyp_mm_celarent_min, h22
    h24 = and_elim_r h23
    h25 = implies_intro h24
