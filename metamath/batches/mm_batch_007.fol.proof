    h107 = iff_elim_l h89, h106
    h108 = iff_elim_l h105, h107
    h109 = iff_elim_r h90, h108
    h110 = implies_intro h109
    h111 = assume elem(_bcv87, h80_w)
    h112 = iff_elim_l h90, h111
    h113 = iff_elim_r h105, h112
    h114 = iff_elim_r h89, h113
    h115 = implies_intro h114
    h116 = iff_intro h110, h115
    h117 = iff_elim_r h88, h116
    h118 = implies_intro h117
    h119 = iff_intro h104, h118
    h120 = forall_intro h119
    h121 = use mm_cdeqi
    h122 = forall_elim h121, x
    h123 = forall_elim h122, y
    h124 = forall_elim h123, h85_w
    h125 = forall_elim h124, u0
    h126 = assume eq(x, y)
    h127 = implies_elim h71, h126
    h128 = forall_elim h120, u0
    h129 = iff_elim_r h128, h127
    h130 = implies_intro h129
    h131 = implies_elim h125, h130
    h132 = assume eq(x, y)
    h133 = implies_elim h131, h132
    h134 = forall_elim h120, u0
    h135 = iff_elim_l h134, h133
    h136 = implies_intro h135
    h137 = and_intro hyp_mm_cdeqim_1, h136
    h138 = and_elim_r h137
    h139 = implies_intro h138
    h140 = and_intro hyp_mm_cdeqnot_1, h139
    h141 = and_elim_r h140
    h142 = implies_intro h141
    h143 = assume ((eq(x, y) -> (elem(u0, S_ph) <-> elem(u0, S_ps))) -> ((eq(x, y) -> (elem(u0, S_ch) <-> elem(u0, S_th))) -> (eq(x, y) -> ((elem(u0, S_ph) -> elem(u0, S_ch)) <-> (elem(u0, S_ps) -> elem(u0, S_th))))))
    h144 = implies_intro h143
    h145 = implies_elim h144, h142
    h146 = forall_intro h145
    h147 = forall_intro h146
    h148 = forall_intro h147
    h149 = forall_intro h148
    h150 = forall_intro h149
    h151 = forall_intro h150
    h152 = forall_intro h151
    qed h152

