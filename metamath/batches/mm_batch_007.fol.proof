# aaan
proof mm_aaan:
    fix x
    fix y
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_aaan_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_aaan_2 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    h1 = use mm_19_26_2
    h2 = forall_elim h1, x
    h3 = forall_elim h2, y
    h4 = forall_elim h3, S_ph
    h5 = forall_elim h4, S_ps
    h6 = forall_elim h5, u0
    h7 = use mm_19_3
    h8 = forall_elim h7, y
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, hyp_mm_aaan_1
    h12 = use mm_albii
    h13 = forall_elim h12, x
    h14 = forall_elim h13, S_ph
    h15 = forall_elim h14, S_ph
    h16 = forall_elim h15, u0
    h17 = implies_elim h16, h11
    h18 = use mm_alcom
    h19 = forall_elim h18, x
    h20 = forall_elim h19, y
    h21 = forall_elim h20, S_ps
    h22 = forall_elim h21, u0
    h23 = use mm_19_3
    h24 = forall_elim h23, x
    h25 = forall_elim h24, S_ps
    h26 = forall_elim h25, u0
    h27 = implies_elim h26, hyp_mm_aaan_2
    h28 = use mm_albii
    h29 = forall_elim h28, y
    h30 = forall_elim h29, S_ps
    h31 = forall_elim h30, S_ps
    h32 = forall_elim h31, u0
    h33 = implies_elim h32, h27
    h34 = use mm_bitri
    h35 = forall_elim h34, S_ps
    h36 = forall_elim h35, S_ps
    h37 = forall_elim h36, S_ps
    h38 = forall_elim h37, u0
    h39 = implies_elim h38, h22
    h40 = implies_elim h39, h33
    h41 = use mm_anbi12i
    h42 = forall_elim h41, S_ph
    h43 = forall_elim h42, S_ph
    h44 = forall_elim h43, S_ps
    h45 = forall_elim h44, S_ps
    h46 = forall_elim h45, u0
    h47 = implies_elim h46, h17
    h48 = implies_elim h47, h40
    h49 = use wff_and
    h50 = forall_elim h49, S_ph
    h51 = forall_elim h50, S_ps
    h53 = iota_elim h51, h52_w
