    h24 = iff_elim_l h23, h22
    h25 = not_elim h21, h24
    h26 = not_intro h25
    h27 = implies_intro h26
    h28 = implies_elim h19, h27
    h29 = assume elem(u0, h8_w)
    h30 = forall_elim h9, u0
    h31 = iff_elim_l h30, h29
    h32 = iff_elim_l h4, h31
    h33 = forall_elim h14, u0
    h34 = iff_elim_r h33, h32
    h35 = implies_intro h34
    h36 = assume elem(u0, h13_w)
    h37 = forall_elim h14, u0
    h38 = iff_elim_l h37, h36
    h39 = iff_elim_r h4, h38
    h40 = forall_elim h9, u0
    h41 = iff_elim_r h40, h39
    h42 = implies_intro h41
    h43 = iff_intro h35, h42
    h44 = implies_elim h28, h43
    h45 = assume elem(u0, S_ph)
    h46 = implies_elim h44, h45
    h47 = assume eq(B, A)
    h48 = forall_elim h14, u0
    h49 = iff_elim_r h48, h47
    h50 = not_elim h46, h49
    h51 = not_intro h50
    h52 = implies_intro h51
    h53 = and_intro hyp_mm_neqcomd_1, h52
    h54 = and_elim_r h53
    h55 = implies_intro h54
    h56 = assume ((elem(u0, S_ph) -> ~eq(A, B)) -> (elem(u0, S_ph) -> ~eq(B, A)))
    h57 = implies_intro h56
    h58 = implies_elim h57, h55
    h59 = forall_intro h58
    h60 = forall_intro h59
    h61 = forall_intro h60
    h62 = forall_intro h61
    qed h62

