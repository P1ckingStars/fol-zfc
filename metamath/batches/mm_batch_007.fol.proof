# Translated from Metamath set.mm

# exlimih
proof mm_exlimih:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_exlimih_1 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    hyp_mm_exlimih_2 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h1 = use mm_nf5i
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_exlimih_1
    h6 = use mm_exlimi
    h7 = forall_elim h6, x
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ps
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h5
    h12 = implies_elim h11, hyp_mm_exlimih_2
    h13 = and_intro hyp_mm_exlimih_2, h12
    h14 = and_elim_r h13
    h15 = implies_intro h14
    h16 = and_intro hyp_mm_exlimih_1, h15
    h17 = and_elim_r h16
    h18 = implies_intro h17
    h19 = assume ((elem(u0, S_ps) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps))))
    h20 = implies_intro h19
    h21 = implies_elim h20, h18
    h22 = forall_intro h21
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    qed h25

# exlimdh
proof mm_exlimdh:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_exlimdh_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_exlimdh_2 = assume (elem(u0, S_ch) -> elem(u0, S_ch))
    hyp_mm_exlimdh_3 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = use mm_nf5i
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_exlimdh_1
    h6 = use mm_nf5i
    h7 = forall_elim h6, x
    h8 = forall_elim h7, S_ch
    h9 = forall_elim h8, u0
    h10 = implies_elim h9, hyp_mm_exlimdh_2
    h11 = use mm_exlimd
    h12 = forall_elim h11, x
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, S_ps
    h15 = forall_elim h14, S_ch
    h16 = forall_elim h15, u0
    h17 = implies_elim h16, h5
    h18 = implies_elim h17, h10
    h19 = implies_elim h18, hyp_mm_exlimdh_3
    h20 = and_intro hyp_mm_exlimdh_3, h19
    h21 = and_elim_r h20
    h22 = implies_intro h21
    h23 = and_intro hyp_mm_exlimdh_2, h22
    h24 = and_elim_r h23
    h25 = implies_intro h24
    h26 = and_intro hyp_mm_exlimdh_1, h25
    h27 = and_elim_r h26
    h28 = implies_intro h27
    h29 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ch) -> elem(u0, S_ch)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))))))
    h30 = implies_intro h29
    h31 = implies_elim h30, h28
    h32 = forall_intro h31
    h33 = forall_intro h32
    h34 = forall_intro h33
    h35 = forall_intro h34
    h36 = forall_intro h35
    qed h36

# hba1
proof mm_hba1:
    fix x
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    qed h5

# hbim1
proof mm_hbim1:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_hbim1_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_hbim1_2 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ps)))
    h1 = use mm_a2i
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_hbim1_2
    h7 = use mm_19_21h
    h8 = forall_elim h7, x
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, S_ps
    h11 = forall_elim h10, u0
    h12 = implies_elim h11, hyp_mm_hbim1_1
    h13 = use wff_impl
    h14 = forall_elim h13, S_ph
    h15 = forall_elim h14, S_ps
    h17 = iota_elim h15, h16_w
    h18 = use wff_impl
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ps
    h22 = iota_elim h20, h21_w
    h23 = use wff_impl
    h24 = forall_elim h23, S_ph
    h25 = forall_elim h24, S_ps
    h27 = iota_elim h25, h26_w
    h28 = use mm_sylibr
    h29 = forall_elim h28, h16_w
    h30 = forall_elim h29, h21_w
    h31 = forall_elim h30, h26_w
    h32 = forall_elim h31, u0
    h33 = assume elem(u0, h16_w)
    h34 = forall_elim h17, u0
    h35 = iff_elim_l h34, h33
    h36 = implies_elim h6, h35
    h37 = forall_elim h22, u0
    h38 = iff_elim_r h37, h36
    h39 = implies_intro h38
    h40 = implies_elim h32, h39
    h41 = assume elem(u0, h26_w)
    h42 = forall_elim h27, u0
    h43 = iff_elim_l h42, h41
    h44 = iff_elim_l h12, h43
    h45 = forall_elim h22, u0
    h46 = iff_elim_r h45, h44
    h47 = implies_intro h46
    h48 = assume elem(u0, h21_w)
    h49 = forall_elim h22, u0
    h50 = iff_elim_l h49, h48
    h51 = iff_elim_r h12, h50
    h52 = forall_elim h27, u0
    h53 = iff_elim_r h52, h51
    h54 = implies_intro h53
    h55 = iff_intro h47, h54
    h56 = implies_elim h40, h55
    h57 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h58 = forall_elim h17, u0
    h59 = iff_elim_r h58, h57
    h60 = implies_elim h56, h59
    h61 = forall_elim h27, u0
    h62 = iff_elim_l h61, h60
    h63 = implies_intro h62
    h64 = and_intro hyp_mm_hbim1_2, h63
    h65 = and_elim_r h64
    h66 = implies_intro h65
    h67 = and_intro hyp_mm_hbim1_1, h66
    h68 = and_elim_r h67
    h69 = implies_intro h68
    h70 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ps))) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps)))))
    h71 = implies_intro h70
    h72 = implies_elim h71, h69
    h73 = forall_intro h72
    h74 = forall_intro h73
    h75 = forall_intro h74
    h76 = forall_intro h75
    qed h76

# hbim
proof mm_hbim:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_hbim_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_hbim_2 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    h1 = use wff_impl
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ps
    h5 = iota_elim h3, h4_w
    h6 = use mm_a1i
    h7 = forall_elim h6, h4_w
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, u0
    h10 = forall_elim h5, u0
    h11 = iff_elim_r h10, hyp_mm_hbim_2
    h12 = implies_elim h9, h11
    h13 = assume elem(u0, S_ph)
    h14 = implies_elim h12, h13
    h15 = forall_elim h5, u0
    h16 = iff_elim_l h15, h14
    h17 = implies_intro h16
    h18 = use mm_hbim1
    h19 = forall_elim h18, x
    h20 = forall_elim h19, S_ph
    h21 = forall_elim h20, S_ps
    h22 = forall_elim h21, u0
    h23 = implies_elim h22, hyp_mm_hbim_1
    h24 = implies_elim h23, h17
    h25 = and_intro hyp_mm_hbim_2, h24
    h26 = and_elim_r h25
    h27 = implies_intro h26
    h28 = and_intro hyp_mm_hbim_1, h27
    h29 = and_elim_r h28
    h30 = implies_intro h29
    h31 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ps) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps)))))
    h32 = implies_intro h31
    h33 = implies_elim h32, h30
    h34 = forall_intro h33
    h35 = forall_intro h34
    h36 = forall_intro h35
    h37 = forall_intro h36
    qed h37

