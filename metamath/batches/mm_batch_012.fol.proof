# Translated from Metamath set.mm

# simplr3
proof mm_simplr3:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix S_ta
    fix u0
    h1 = use mm_simp3
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = use wff_and
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h10 = exists_elim h8, h9_w
    h11 = forall_elim h10, u0
    h12 = use wff_and
    h13 = forall_elim h12, h9_w
    h14 = forall_elim h13, S_ch
    h16 = exists_elim h14, h15_w
    h17 = forall_elim h16, u0
    h18 = assume elem(u0, h15_w)
    h19 = iff_elim_l h17, h18
    h20 = and_elim_l h19
    h21 = iff_elim_l h11, h20
    h22 = and_elim_r h19
    h23 = and_intro h21, h22
    h24 = implies_intro h23
    h25 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))
    h26 = and_elim_l h25
    h27 = iff_elim_r h11, h26
    h28 = and_elim_r h25
    h29 = and_intro h27, h28
    h30 = iff_elim_r h17, h29
    h31 = implies_intro h30
    h32 = iff_intro h24, h31
    h33 = use mm_ad2antlr
    h34 = forall_elim h33, h15_w
    h35 = forall_elim h34, S_ch
    h36 = forall_elim h35, S_th
    h37 = forall_elim h36, S_ta
    h38 = forall_elim h37, u0
    h39 = assume elem(u0, h15_w)
    h40 = iff_elim_l h32, h39
    h41 = implies_elim h5, h40
    h42 = implies_intro h41
    h43 = implies_elim h38, h42
    h44 = assume ((elem(u0, S_th) & ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))) & elem(u0, S_ta))
    h45 = and_elim_l h44
    h46 = and_elim_l h45
    h47 = and_elim_r h45
    h48 = iff_elim_r h32, h47
    h49 = and_intro h46, h48
    h50 = and_elim_r h44
    h51 = and_intro h49, h50
    h52 = implies_elim h43, h51
    h53 = implies_intro h52
    h54 = exists_intro h53
    h55 = exists_intro h54
    h56 = assume (((elem(u0, S_th) & ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))) & elem(u0, S_ta)) -> elem(u0, S_ch))
    h57 = implies_intro h56
    h58 = implies_elim h57, h55
    h59 = forall_intro h58
    h60 = forall_intro h59
    h61 = forall_intro h60
    h62 = forall_intro h61
    h63 = forall_intro h62
    h64 = forall_intro h63
    qed h64

