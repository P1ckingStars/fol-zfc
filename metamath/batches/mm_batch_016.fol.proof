# eximii
proof mm_eximii:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_eximii_1 = assume elem(u0, S_ph)
    hyp_mm_eximii_2 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h1 = use mm_eximi
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_eximii_2
    h7 = implies_elim h6, hyp_mm_eximii_1
    h8 = and_intro hyp_mm_eximii_2, h7
    h9 = and_elim_r h8
    h10 = implies_intro h9
    h11 = and_intro hyp_mm_eximii_1, h10
    h12 = and_elim_r h11
    h13 = implies_intro h12
    h14 = assume (elem(u0, S_ph) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> elem(u0, S_ps)))
    h15 = implies_intro h14
    h16 = implies_elim h15, h13
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    h20 = forall_intro h19
    qed h20

