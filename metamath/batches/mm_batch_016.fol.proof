# alrimdh
proof mm_alrimdh:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_alrimdh_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_alrimdh_2 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    hyp_mm_alrimdh_3 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = use mm_alimdh
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, S_ch
    h6 = forall_elim h5, u0
    h7 = implies_elim h6, hyp_mm_alrimdh_1
    h8 = implies_elim h7, hyp_mm_alrimdh_3
    h9 = use mm_syl5
    h10 = forall_elim h9, S_ps
    h11 = forall_elim h10, S_ps
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, S_ch
    h14 = forall_elim h13, u0
    h15 = implies_elim h14, hyp_mm_alrimdh_2
    h16 = implies_elim h15, h8
    h17 = and_intro hyp_mm_alrimdh_3, h16
    h18 = and_elim_r h17
    h19 = implies_intro h18
    h20 = and_intro hyp_mm_alrimdh_2, h19
    h21 = and_elim_r h20
    h22 = implies_intro h21
    h23 = and_intro hyp_mm_alrimdh_1, h22
    h24 = and_elim_r h23
    h25 = implies_intro h24
    h26 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ps) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))))))
    h27 = implies_intro h26
    h28 = implies_elim h27, h25
    h29 = forall_intro h28
    h30 = forall_intro h29
    h31 = forall_intro h30
    h32 = forall_intro h31
    h33 = forall_intro h32
    qed h33

