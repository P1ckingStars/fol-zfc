# tbwsyl
proof mm_tbwsyl:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_tbwsyl_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_tbwsyl_2 = assume (elem(u0, S_ps) -> elem(u0, S_ch))
    h1 = use mm_tbw_ax1
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_tbwsyl_1
    h7 = implies_elim h6, hyp_mm_tbwsyl_2
    h8 = and_intro hyp_mm_tbwsyl_2, h7
    h9 = and_elim_r h8
    h10 = implies_intro h9
    h11 = and_intro hyp_mm_tbwsyl_1, h10
    h12 = and_elim_r h11
    h13 = implies_intro h12
    h14 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h15 = implies_intro h14
    h16 = implies_elim h15, h13
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    h20 = forall_intro h19
    qed h20

