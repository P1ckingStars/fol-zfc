# tbw-ax1
proof mm_tbw_ax1:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    h1 = use mm_imim1
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h7 = implies_intro h6
    h8 = implies_elim h7, h5
    h9 = forall_intro h8
    h10 = forall_intro h9
    h11 = forall_intro h10
    h12 = forall_intro h11
    qed h12

# tbw-ax2
proof mm_tbw_ax2:
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = assume elem(u0, S_ps)
    h3 = and_intro h1, h2
    h4 = and_elim_l h3
    h5 = implies_intro h4
    h6 = implies_intro h5
    h7 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ph)))
    h8 = implies_intro h7
    h9 = implies_elim h8, h6
    h10 = forall_intro h9
    h11 = forall_intro h10
    h12 = forall_intro h11
    qed h12

