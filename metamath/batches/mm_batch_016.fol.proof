    h16 = forall_elim h15, S_ph
    h17 = forall_elim h16, h11_w
    h18 = forall_elim h17, u0
    h19 = implies_elim h18, hyp_mm_eximdh_1
    h20 = assume elem(u0, S_ph)
    h21 = implies_elim h7, h20
    h22 = iff_elim_r h13, h21
    h23 = implies_intro h22
    h24 = implies_elim h19, h23
    h25 = assume elem(u0, S_ph)
    h26 = implies_elim h24, h25
    h27 = iff_elim_l h13, h26
    h28 = implies_intro h27
    h29 = exists_intro h28
    h30 = and_intro hyp_mm_eximdh_2, h29
    h31 = and_elim_r h30
    h32 = implies_intro h31
    h33 = and_intro hyp_mm_eximdh_1, h32
    h34 = and_elim_r h33
    h35 = implies_intro h34
    h36 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))))
    h37 = implies_intro h36
    h38 = implies_elim h37, h35
    h39 = forall_intro h38
    h40 = forall_intro h39
    h41 = forall_intro h40
    h42 = forall_intro h41
    h43 = forall_intro h42
    qed h43

