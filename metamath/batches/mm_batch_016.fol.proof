    h2 = implies_intro h1
    h3 = assume ~elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
