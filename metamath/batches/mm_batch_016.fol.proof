# 2exnexn
proof mm_2exnexn:
    fix x
    fix y
    fix S_ph
    fix u0
    h1 = use mm_alexn
    h2 = forall_elim h1, x
    h3 = forall_elim h2, y
    h4 = forall_elim h3, S_ph
    h5 = forall_elim h4, u0
    h6 = use wff_neg
    h7 = forall_elim h6, S_ph
    h9 = exists_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_con2bii
    h12 = forall_elim h11, h8_w
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, u0
    h15 = assume elem(u0, h8_w)
    h16 = iff_elim_l h10, h15
    h17 = iff_elim_l h5, h16
    h18 = implies_intro h17
    h19 = assume ~elem(u0, S_ph)
    h20 = iff_elim_r h5, h19
    h21 = iff_elim_r h10, h20
    h22 = implies_intro h21
    h23 = iff_intro h18, h22
    h24 = implies_elim h14, h23
    h25 = assume elem(u0, S_ph)
    h26 = iff_elim_l h24, h25
    h27 = assume ~elem(u0, S_ph)
    h28 = iff_elim_r h10, h27
    h29 = not_elim h26, h28
    h30 = not_intro h29
    h31 = implies_intro h30
    h32 = assume ~~elem(u0, S_ph)
    h33 = assume elem(u0, h8_w)
    h34 = iff_elim_l h10, h33
    h35 = not_elim h32, h34
    h36 = not_intro h35
    h37 = iff_elim_r h24, h36
    h38 = implies_intro h37
    h39 = iff_intro h31, h38
    h40 = exists_intro h39
    h41 = assume (elem(u0, S_ph) <-> ~~elem(u0, S_ph))
    h42 = implies_intro h41
    h43 = implies_elim h42, h40
    h44 = forall_intro h43
    h45 = forall_intro h44
    h46 = forall_intro h45
    h47 = forall_intro h46
    qed h47

