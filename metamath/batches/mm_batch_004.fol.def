claim mm_elsni: forall A. forall B. forall u0. (eq(A, B) -> eq(A, B))

# elsnd
claim mm_elsnd: forall A. forall B. forall S_ph. forall u0. ((elem(u0, S_ph) -> eq(A, B)) -> (elem(u0, S_ph) -> eq(A, B)))

# elpri
claim mm_elpri: forall A. forall B. forall C. forall u0. ((eq(A, B) | eq(A, C)) -> (eq(A, B) | eq(A, C)))

# nelsn
claim mm_nelsn: forall A. forall B. forall u0. (~eq(A, B) -> ~eq(A, B))

# eltpi
claim mm_eltpi: forall A. forall B. forall C. forall D. forall u0. (((eq(A, B) | eq(A, C)) | eq(A, D)) -> ((eq(A, B) | eq(A, C)) | eq(A, D)))

# eldifsn
claim mm_eldifsn: forall A. forall B. forall C. forall u0. ((elem(A, B) & ~eq(A, C)) <-> (elem(A, B) & ~eq(A, C)))

# nfiu1
claim mm_nfiu1: forall x. forall A. forall B. forall zz0. forall zz1. forall u0. ((exists x. (elem(x, A) & elem(zz1, B))) -> (exists x. (elem(x, A) & elem(zz1, B))))

# nfiu1OLD
claim mm_nfiu1OLD: forall x. forall A. forall B. forall zz0. forall zz1. forall u0. ((exists x. (elem(x, A) & elem(zz1, B))) -> (exists x. (elem(x, A) & elem(zz1, B))))

# nfii1
claim mm_nfii1: forall x. forall A. forall B. forall zz0. forall zz1. forall u0. ((forall x. (elem(x, A) -> elem(zz1, B))) -> (forall x. (elem(x, A) -> elem(zz1, B))))

