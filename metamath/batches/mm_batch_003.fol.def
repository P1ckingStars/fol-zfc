# xorneg2
claim mm_xorneg2: forall S_ph. forall S_ps. forall u0. (~(elem(u0, S_ph) <-> ~elem(u0, S_ps)) <-> ~ ~(elem(u0, S_ph) <-> elem(u0, S_ps)))

# xorneg1
claim mm_xorneg1: forall S_ph. forall S_ps. forall u0. (~(~elem(u0, S_ph) <-> elem(u0, S_ps)) <-> ~ ~(elem(u0, S_ph) <-> elem(u0, S_ps)))

# xorneg
