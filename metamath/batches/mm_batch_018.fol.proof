# axc7
proof mm_axc7:
    fix x
    fix S_ph
    fix u0
    h1 = use mm_sp
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = use mm_hbn1
    h6 = forall_elim h5, x
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, u0
    h9 = use wff_neg
    h10 = forall_elim h9, S_ph
    h12 = exists_elim h10, h11_w
    h13 = forall_elim h12, u0
    h14 = use mm_nsyl4
    h15 = forall_elim h14, S_ph
    h16 = forall_elim h15, S_ph
    h17 = forall_elim h16, h11_w
    h18 = forall_elim h17, u0
    h19 = implies_elim h18, h4
    h20 = assume ~elem(u0, S_ph)
    h21 = implies_elim h8, h20
    h22 = iff_elim_r h13, h21
    h23 = implies_intro h22
    h24 = implies_elim h19, h23
    h25 = assume ~~elem(u0, S_ph)
    h26 = assume elem(u0, h11_w)
    h27 = iff_elim_l h13, h26
    h28 = not_elim h25, h27
    h29 = not_intro h28
    h30 = implies_elim h24, h29
    h31 = implies_intro h30
    h32 = exists_intro h31
    h33 = assume (~~elem(u0, S_ph) -> elem(u0, S_ph))
    h34 = implies_intro h33
    h35 = implies_elim h34, h32
    h36 = forall_intro h35
    h37 = forall_intro h36
    h38 = forall_intro h37
    qed h38

