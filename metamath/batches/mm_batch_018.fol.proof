# Translated from Metamath set.mm

# alrot4
proof mm_alrot4:
    fix x
    fix y
    fix z
    fix w
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = assume elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    h11 = forall_intro h10
    qed h11

