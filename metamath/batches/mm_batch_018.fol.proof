# modal-b
proof mm_modal_b:
    fix x
    fix S_ph
    fix u0
    h1 = use wff_neg
    h2 = forall_elim h1, S_ph
    h4 = exists_elim h2, h3_w
    h5 = forall_elim h4, u0
    h6 = use mm_axc7
    h7 = forall_elim h6, x
    h8 = forall_elim h7, h3_w
    h9 = forall_elim h8, u0
    h10 = assume ~~~elem(u0, S_ph)
    h11 = assume ~elem(u0, h3_w)
    h12 = assume ~elem(u0, S_ph)
    h13 = iff_elim_r h5, h12
    h14 = not_elim h11, h13
    h15 = not_intro h14
    h16 = not_elim h10, h15
    h17 = not_intro h16
    h18 = implies_elim h9, h17
    h19 = iff_elim_l h5, h18
    h20 = implies_intro h19
    h21 = exists_intro h20
    h22 = use wff_neg
    h23 = forall_elim h22, S_ph
    h25 = exists_elim h23, h24_w
    h26 = forall_elim h25, u0
    h27 = use wff_neg
    h28 = forall_elim h27, h24_w
    h30 = exists_elim h28, h29_w
    h31 = forall_elim h30, u0
    h32 = assume elem(u0, h29_w)
    h33 = iff_elim_l h31, h32
    h34 = assume ~elem(u0, S_ph)
    h35 = iff_elim_r h26, h34
    h36 = not_elim h33, h35
    h37 = not_intro h36
    h38 = implies_intro h37
    h39 = assume ~~elem(u0, S_ph)
    h40 = assume elem(u0, h24_w)
    h41 = iff_elim_l h26, h40
    h42 = not_elim h39, h41
    h43 = not_intro h42
    h44 = iff_elim_r h31, h43
    h45 = implies_intro h44
    h46 = iff_intro h38, h45
    h47 = use mm_con4i
    h48 = forall_elim h47, h29_w
    h49 = forall_elim h48, S_ph
    h50 = forall_elim h49, u0
    h51 = assume ~elem(u0, h29_w)
    h52 = assume ~~elem(u0, S_ph)
    h53 = iff_elim_r h46, h52
    h54 = not_elim h51, h53
    h55 = not_intro h54
    h56 = implies_elim h21, h55
    h57 = implies_intro h56
    h58 = implies_elim h50, h57
    h59 = assume elem(u0, S_ph)
    h60 = implies_elim h58, h59
    h61 = iff_elim_l h46, h60
    h62 = implies_intro h61
    h63 = exists_intro h62
    h64 = exists_intro h63
    h65 = assume (elem(u0, S_ph) -> ~~elem(u0, S_ph))
    h66 = implies_intro h65
    h67 = implies_elim h66, h64
    h68 = forall_intro h67
    h69 = forall_intro h68
    h70 = forall_intro h69
    qed h70

