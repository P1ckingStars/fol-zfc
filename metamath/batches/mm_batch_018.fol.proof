# drex1
proof mm_drex1:
    fix x
    fix y
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume (eq(x, y) -> (elem(u0, S_ph) <-> elem(u0, S_ps)))
    h2 = implies_intro h1
    h3 = forall_intro h2
