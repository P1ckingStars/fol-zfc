# elriin
proof mm_elriin:
    fix x
    fix A
    fix B
    fix S
    fix X
    fix u0
    h1 = assume (elem(B, A) & (forall x. (elem(x, X) -> elem(B, S))))
    h2 = implies_intro h1
    h3 = assume (elem(B, A) & (forall x. (elem(x, X) -> elem(B, S))))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    h11 = forall_intro h10
    qed h11

