# dfcleq
proof mm_dfcleq:
    fix x
    fix A
    fix B
    fix y
    fix z
    fix v
    fix u
    fix t
    fix u0
    h1 = use mm_axextb
    h2 = forall_elim h1, y
    h3 = forall_elim h2, z
    h4 = forall_elim h3, u
    h5 = forall_elim h4, u0
    h6 = use mm_axextb
    h7 = forall_elim h6, t
    h8 = forall_elim h7, t
    h9 = forall_elim h8, v
    h10 = forall_elim h9, u0
    h11 = use axextb_bridge
    h12 = forall_elim h11, A
    h13 = forall_elim h12, B
    h14 = assume (eq(A, B) <-> (forall x. (elem(x, A) <-> elem(x, B))))
    h15 = implies_intro h14
    h16 = implies_elim h15, h13
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    h20 = forall_intro h19
    h21 = forall_intro h20
    h22 = forall_intro h21
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    qed h25

