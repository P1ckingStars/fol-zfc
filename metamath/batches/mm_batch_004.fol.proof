    h38 = iff_elim_l h35, h37
    h39 = iff_elim_l h18, h38
    h40 = implies_intro h39
    h41 = assume (elem(u0, S_ph) & elem(u0, S_ps))
    h42 = iff_elim_r h18, h41
    h43 = iff_elim_r h35, h42
    h44 = iff_elim_l h12, h43
    h45 = implies_intro h44
    h46 = iff_intro h40, h45
    h47 = use mm_nfex
    h48 = forall_elim h47, x
    h49 = forall_elim h48, y
    h50 = forall_elim h49, S_ps
    h51 = forall_elim h50, u0
    h52 = implies_elim h51, hyp_mm_eean_2
    h53 = use mm_19_41
    h54 = forall_elim h53, x
    h55 = forall_elim h54, S_ph
    h56 = forall_elim h55, S_ps
    h57 = forall_elim h56, u0
    h58 = implies_elim h57, h52
    h59 = use wff_and
    h60 = forall_elim h59, S_ph
    h61 = forall_elim h60, S_ps
    h63 = iota_elim h61, h62_w
    h64 = forall_elim h63, u0
    h65 = use wff_and
    h66 = forall_elim h65, S_ph
    h67 = forall_elim h66, S_ps
    h69 = iota_elim h67, h68_w
    h70 = forall_elim h69, u0
    h71 = use wff_and
    h72 = forall_elim h71, S_ph
    h73 = forall_elim h72, S_ps
    h75 = iota_elim h73, h74_w
    h76 = forall_elim h75, u0
    h77 = use mm_bitri
    h78 = forall_elim h77, h62_w
    h79 = forall_elim h78, h68_w
    h80 = forall_elim h79, h74_w
    h81 = forall_elim h80, u0
    h82 = assume elem(u0, h62_w)
    h83 = iff_elim_l h64, h82
    h84 = iff_elim_l h46, h83
    h85 = iff_elim_r h70, h84
    h86 = implies_intro h85
    h87 = assume elem(u0, h68_w)
    h88 = iff_elim_l h70, h87
    h89 = iff_elim_r h46, h88
    h90 = iff_elim_r h64, h89
    h91 = implies_intro h90
    h92 = iff_intro h86, h91
    h93 = implies_elim h81, h92
    h94 = assume elem(u0, h68_w)
    h95 = iff_elim_l h70, h94
    h96 = iff_elim_l h58, h95
    h97 = iff_elim_r h76, h96
    h98 = implies_intro h97
    h99 = assume elem(u0, h74_w)
    h100 = iff_elim_l h76, h99
    h101 = iff_elim_r h58, h100
    h102 = iff_elim_r h70, h101
    h103 = implies_intro h102
    h104 = iff_intro h98, h103
    h105 = implies_elim h93, h104
    h106 = assume (elem(u0, S_ph) & elem(u0, S_ps))
    h107 = iff_elim_r h64, h106
    h108 = iff_elim_l h105, h107
    h109 = iff_elim_l h76, h108
    h110 = implies_intro h109
    h111 = assume (elem(u0, S_ph) & elem(u0, S_ps))
    h112 = iff_elim_r h76, h111
    h113 = iff_elim_r h105, h112
    h114 = iff_elim_l h64, h113
    h115 = implies_intro h114
    h116 = iff_intro h110, h115
    h117 = and_intro hyp_mm_eean_2, h116
    h118 = and_elim_r h117
    h119 = implies_intro h118
    h120 = and_intro hyp_mm_eean_1, h119
    h121 = and_elim_r h120
    h122 = implies_intro h121
    h123 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ps) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) & elem(u0, S_ps)) <-> (elem(u0, S_ph) & elem(u0, S_ps)))))
    h124 = implies_intro h123
    h125 = implies_elim h124, h122
    h126 = forall_intro h125
    h127 = forall_intro h126
    h128 = forall_intro h127
    h129 = forall_intro h128
    h130 = forall_intro h129
    qed h130

