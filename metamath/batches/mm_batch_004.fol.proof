# eqsb1
proof mm_eqsb1:
    fix x
    fix y
    fix A
    fix u0
    h1 = assume eq(y, A)
    h2 = implies_intro h1
    h3 = assume eq(y, A)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    qed h9

