    h3 = assume elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    qed h10

# sbccsb2
proof mm_sbccsb2:
    fix x
    fix A
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = assume elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    qed h9

# elif
proof mm_elif:
    fix A
    fix B
    fix C
    fix S_ph
    fix u0
    h1 = assume ((elem(u0, S_ph) & elem(A, B)) | (~elem(u0, S_ph) & elem(A, C)))
    h2 = implies_intro h1
    h3 = assume ((elem(u0, S_ph) & elem(A, B)) | (~elem(u0, S_ph) & elem(A, C)))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    qed h10

