# hbim1
proof mm_hbim1:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_hbim1_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_hbim1_2 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ps)))
    h1 = use mm_a2i
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_hbim1_2
    h7 = use mm_19_21h
    h8 = forall_elim h7, x
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, S_ps
    h11 = forall_elim h10, u0
    h12 = implies_elim h11, hyp_mm_hbim1_1
    h13 = use wff_impl
    h14 = forall_elim h13, S_ph
    h15 = forall_elim h14, S_ps
    h17 = iota_elim h15, h16_w
    h18 = forall_elim h17, u0
    h19 = use wff_impl
    h20 = forall_elim h19, S_ph
    h21 = forall_elim h20, S_ps
    h23 = iota_elim h21, h22_w
    h24 = forall_elim h23, u0
    h25 = use wff_impl
    h26 = forall_elim h25, S_ph
    h27 = forall_elim h26, S_ps
    h29 = iota_elim h27, h28_w
    h30 = forall_elim h29, u0
    h31 = use mm_sylibr
    h32 = forall_elim h31, h16_w
    h33 = forall_elim h32, h22_w
    h34 = forall_elim h33, h28_w
    h35 = forall_elim h34, u0
    h36 = assume elem(u0, h16_w)
    h37 = iff_elim_l h18, h36
    h38 = implies_elim h6, h37
    h39 = iff_elim_r h24, h38
    h40 = implies_intro h39
    h41 = implies_elim h35, h40
    h42 = assume elem(u0, h28_w)
    h43 = iff_elim_l h30, h42
    h44 = iff_elim_l h12, h43
    h45 = iff_elim_r h24, h44
    h46 = implies_intro h45
    h47 = assume elem(u0, h22_w)
    h48 = iff_elim_l h24, h47
    h49 = iff_elim_r h12, h48
    h50 = iff_elim_r h30, h49
    h51 = implies_intro h50
    h52 = iff_intro h46, h51
    h53 = implies_elim h41, h52
    h54 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h55 = iff_elim_r h18, h54
    h56 = implies_elim h53, h55
    h57 = iff_elim_l h30, h56
    h58 = implies_intro h57
    h59 = and_intro hyp_mm_hbim1_2, h58
    h60 = and_elim_r h59
    h61 = implies_intro h60
    h62 = and_intro hyp_mm_hbim1_1, h61
    h63 = and_elim_r h62
    h64 = implies_intro h63
    h65 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ps))) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps)))))
    h66 = implies_intro h65
    h67 = implies_elim h66, h64
    h68 = forall_intro h67
    h69 = forall_intro h68
    h70 = forall_intro h69
    h71 = forall_intro h70
    qed h71

# hbim
proof mm_hbim:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_hbim_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_hbim_2 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    h1 = use wff_impl
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ps
    h5 = iota_elim h3, h4_w
    h6 = forall_elim h5, u0
    h7 = use mm_a1i
    h8 = forall_elim h7, h4_w
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, u0
    h11 = iff_elim_r h6, hyp_mm_hbim_2
    h12 = implies_elim h10, h11
    h13 = assume elem(u0, S_ph)
    h14 = implies_elim h12, h13
    h15 = iff_elim_l h6, h14
    h16 = implies_intro h15
    h17 = use mm_hbim1
    h18 = forall_elim h17, x
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ps
    h21 = forall_elim h20, u0
    h22 = implies_elim h21, hyp_mm_hbim_1
    h23 = implies_elim h22, h16
    h24 = and_intro hyp_mm_hbim_2, h23
    h25 = and_elim_r h24
    h26 = implies_intro h25
    h27 = and_intro hyp_mm_hbim_1, h26
    h28 = and_elim_r h27
    h29 = implies_intro h28
    h30 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ps) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps)))))
    h31 = implies_intro h30
    h32 = implies_elim h31, h29
    h33 = forall_intro h32
    h34 = forall_intro h33
    h35 = forall_intro h34
    h36 = forall_intro h35
    qed h36

