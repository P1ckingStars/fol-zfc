# neii
proof mm_neii:
    fix A
    fix B
    fix u0
    hyp_mm_neii_1 = assume ne(A, B)
    h1 = use ne_def
    h2 = forall_elim h1, A
    h3 = forall_elim h2, B
    h4 = use wff_ne
    h5 = forall_elim h4, A
    h6 = forall_elim h5, B
    h8 = iota_elim h6, h7_w
    h9 = forall_elim h8, u0
    h10 = use wff_eq
    h11 = forall_elim h10, A
    h12 = forall_elim h11, B
    h14 = iota_elim h12, h13_w
    h15 = forall_elim h14, u0
    h16 = use wff_neg
    h17 = forall_elim h16, h13_w
    h19 = iota_elim h17, h18_w
    h20 = forall_elim h19, u0
    h21 = assume elem(u0, h18_w)
    h22 = iff_elim_l h20, h21
    h23 = assume eq(A, B)
    h24 = iff_elim_r h15, h23
    h25 = not_elim h22, h24
    h26 = not_intro h25
    h27 = implies_intro h26
    h28 = assume ~eq(A, B)
    h29 = assume elem(u0, h13_w)
    h30 = iff_elim_l h15, h29
    h31 = not_elim h28, h30
    h32 = not_intro h31
    h33 = iff_elim_r h20, h32
    h34 = implies_intro h33
    h35 = iff_intro h27, h34
    h36 = use mm_mpbi
    h37 = forall_elim h36, h7_w
    h38 = forall_elim h37, h18_w
    h39 = forall_elim h38, u0
    h40 = iff_elim_r h9, hyp_mm_neii_1
    h41 = implies_elim h39, h40
    h42 = assume elem(u0, h7_w)
    h43 = iff_elim_l h9, h42
    h44 = iff_elim_l h3, h43
    h45 = iff_elim_r h35, h44
    h46 = implies_intro h45
    h47 = assume elem(u0, h18_w)
    h48 = iff_elim_l h35, h47
    h49 = iff_elim_r h3, h48
    h50 = iff_elim_r h9, h49
    h51 = implies_intro h50
    h52 = iff_intro h46, h51
    h53 = implies_elim h41, h52
    h54 = iff_elim_l h35, h53
    h55 = and_intro hyp_mm_neii_1, h54
    h56 = and_elim_r h55
    h57 = implies_intro h56
    h58 = assume (ne(A, B) -> ~eq(A, B))
    h59 = implies_intro h58
    h60 = implies_elim h59, h57
    h61 = forall_intro h60
    h62 = forall_intro h61
    h63 = forall_intro h62
    qed h63

# neir
proof mm_neir:
    fix A
