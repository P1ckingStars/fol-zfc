# nf5di
proof mm_nf5di:
    fix x
    fix S_ph
    fix u0
    hyp_mm_nf5di_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ph) -> elem(u0, S_ph)))
    h1 = use mm_nf5rd
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ph
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_nf5di_1
    h7 = use mm_pm2_43i
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h6
    h12 = use mm_nf5i
    h13 = forall_elim h12, x
    h14 = forall_elim h13, S_ph
    h15 = forall_elim h14, u0
    h16 = implies_elim h15, h11
    h17 = and_intro hyp_mm_nf5di_1, h16
    h18 = and_elim_r h17
    h19 = implies_intro h18
    h20 = assume ((elem(u0, S_ph) -> (elem(u0, S_ph) -> elem(u0, S_ph))) -> (elem(u0, S_ph) -> elem(u0, S_ph)))
    h21 = implies_intro h20
    h22 = implies_elim h21, h19
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    qed h25

# 19.9h
proof mm_19_9h:
    fix x
    fix S_ph
    fix u0
    hyp_mm_19_9h_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    h1 = use mm_nf5i
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_19_9h_1
    h6 = use mm_19_9
    h7 = forall_elim h6, x
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, u0
    h10 = implies_elim h9, h5
    h11 = and_intro hyp_mm_19_9h_1, h10
    h12 = and_elim_r h11
    h13 = implies_intro h12
    h14 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> (elem(u0, S_ph) <-> elem(u0, S_ph)))
    h15 = implies_intro h14
    h16 = implies_elim h15, h13
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    qed h19

