    h5 = use wff_eq
    h6 = forall_elim h5, A
    h7 = forall_elim h6, A
    h9 = iota_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_a1i
    h12 = forall_elim h11, h8_w
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, u0
    h15 = iff_elim_r h10, h4
    h16 = implies_elim h14, h15
    h17 = assume elem(u0, S_ph)
    h18 = implies_elim h16, h17
    h19 = iff_elim_l h10, h18
    h20 = implies_intro h19
    h21 = assume (elem(u0, S_ph) -> eq(A, A))
    h22 = implies_intro h21
    h23 = implies_elim h22, h20
    h24 = forall_intro h23
    h25 = forall_intro h24
    h26 = forall_intro h25
