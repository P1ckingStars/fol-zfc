# Translated from Metamath set.mm

# nfs1f
proof mm_nfs1f:
    fix x
    fix y
    fix S_ph
    fix u0
    h1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    h6 = forall_intro h5
    qed h6

# sbn
proof mm_sbn:
    fix x
    fix t
    fix y
    fix S_ph
    fix u0
    h1 = assume ~elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = assume ~elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    qed h10

