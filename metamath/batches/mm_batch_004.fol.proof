# exlimih
proof mm_exlimih:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_exlimih_1 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    hyp_mm_exlimih_2 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h1 = use mm_nf5i
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_exlimih_1
    h6 = use mm_exlimi
    h7 = forall_elim h6, x
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ps
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h5
    h12 = implies_elim h11, hyp_mm_exlimih_2
    h13 = and_intro hyp_mm_exlimih_2, h12
    h14 = and_elim_r h13
    h15 = implies_intro h14
    h16 = and_intro hyp_mm_exlimih_1, h15
    h17 = and_elim_r h16
    h18 = implies_intro h17
    h19 = assume ((elem(u0, S_ps) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps))))
    h20 = implies_intro h19
    h21 = implies_elim h20, h18
    h22 = forall_intro h21
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    qed h25

# exlimdh
proof mm_exlimdh:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_exlimdh_1 = assume (elem(u0, S_ph) -> elem(u0, S_ph))
    hyp_mm_exlimdh_2 = assume (elem(u0, S_ch) -> elem(u0, S_ch))
    hyp_mm_exlimdh_3 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = use mm_nf5i
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_exlimdh_1
    h6 = use mm_nf5i
    h7 = forall_elim h6, x
    h8 = forall_elim h7, S_ch
    h9 = forall_elim h8, u0
    h10 = implies_elim h9, hyp_mm_exlimdh_2
    h11 = use mm_exlimd
    h12 = forall_elim h11, x
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, S_ps
    h15 = forall_elim h14, S_ch
    h16 = forall_elim h15, u0
    h17 = implies_elim h16, h5
    h18 = implies_elim h17, h10
    h19 = implies_elim h18, hyp_mm_exlimdh_3
    h20 = and_intro hyp_mm_exlimdh_3, h19
    h21 = and_elim_r h20
    h22 = implies_intro h21
    h23 = and_intro hyp_mm_exlimdh_2, h22
    h24 = and_elim_r h23
    h25 = implies_intro h24
    h26 = and_intro hyp_mm_exlimdh_1, h25
    h27 = and_elim_r h26
    h28 = implies_intro h27
    h29 = assume ((elem(u0, S_ph) -> elem(u0, S_ph)) -> ((elem(u0, S_ch) -> elem(u0, S_ch)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))))))
    h30 = implies_intro h29
    h31 = implies_elim h30, h28
    h32 = forall_intro h31
    h33 = forall_intro h32
    h34 = forall_intro h33
    h35 = forall_intro h34
    h36 = forall_intro h35
    qed h36

