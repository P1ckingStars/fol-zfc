    h5 = forall_intro h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    qed h7

# eqcoms
proof mm_eqcoms:
    fix A
    fix B
    fix S_ph
    fix u0
    hyp_mm_eqcoms_1 = assume (eq(A, B) -> elem(u0, S_ph))
    h1 = use mm_eqcom
    h2 = forall_elim h1, B
    h3 = forall_elim h2, A
    h4 = forall_elim h3, u0
    h5 = use wff_eq
    h6 = forall_elim h5, B
    h7 = forall_elim h6, A
    h9 = iota_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use wff_eq
    h12 = forall_elim h11, A
    h13 = forall_elim h12, B
    h15 = iota_elim h13, h14_w
    h16 = forall_elim h15, u0
    h17 = use mm_sylbi
    h18 = forall_elim h17, h8_w
    h19 = forall_elim h18, h14_w
    h20 = forall_elim h19, S_ph
    h21 = forall_elim h20, u0
    h22 = assume elem(u0, h8_w)
    h23 = iff_elim_l h10, h22
    h24 = iff_elim_l h4, h23
    h25 = iff_elim_r h16, h24
    h26 = implies_intro h25
    h27 = assume elem(u0, h14_w)
    h28 = iff_elim_l h16, h27
    h29 = iff_elim_r h4, h28
    h30 = iff_elim_r h10, h29
    h31 = implies_intro h30
    h32 = iff_intro h26, h31
    h33 = implies_elim h21, h32
    h34 = assume elem(u0, h14_w)
    h35 = iff_elim_l h16, h34
    h36 = implies_elim hyp_mm_eqcoms_1, h35
    h37 = implies_intro h36
    h38 = implies_elim h33, h37
    h39 = assume eq(B, A)
    h40 = iff_elim_r h10, h39
    h41 = implies_elim h38, h40
    h42 = implies_intro h41
    h43 = and_intro hyp_mm_eqcoms_1, h42
    h44 = and_elim_r h43
    h45 = implies_intro h44
    h46 = assume ((eq(A, B) -> elem(u0, S_ph)) -> (eq(B, A) -> elem(u0, S_ph)))
    h47 = implies_intro h46
    h48 = implies_elim h47, h45
    h49 = forall_intro h48
    h50 = forall_intro h49
    h51 = forall_intro h50
    h52 = forall_intro h51
    qed h52

# eqcomi
proof mm_eqcomi:
    fix A
    fix B
    fix u0
    hyp_mm_eqcomi_1 = assume eq(A, B)
    h1 = use mm_eqcom
    h2 = forall_elim h1, A
    h3 = forall_elim h2, B
    h4 = forall_elim h3, u0
    h5 = use wff_eq
    h6 = forall_elim h5, A
    h7 = forall_elim h6, B
    h9 = iota_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use wff_eq
    h12 = forall_elim h11, B
    h13 = forall_elim h12, A
    h15 = iota_elim h13, h14_w
    h16 = forall_elim h15, u0
    h17 = use mm_mpbi
    h18 = forall_elim h17, h8_w
    h19 = forall_elim h18, h14_w
    h20 = forall_elim h19, u0
    h21 = iff_elim_r h10, hyp_mm_eqcomi_1
    h22 = implies_elim h20, h21
    h23 = assume elem(u0, h8_w)
    h24 = iff_elim_l h10, h23
    h25 = iff_elim_l h4, h24
    h26 = iff_elim_r h16, h25
    h27 = implies_intro h26
    h28 = assume elem(u0, h14_w)
    h29 = iff_elim_l h16, h28
    h30 = iff_elim_r h4, h29
    h31 = iff_elim_r h10, h30
    h32 = implies_intro h31
    h33 = iff_intro h27, h32
    h34 = implies_elim h22, h33
    h35 = iff_elim_l h16, h34
    h36 = and_intro hyp_mm_eqcomi_1, h35
    h37 = and_elim_r h36
    h38 = implies_intro h37
    h39 = assume (eq(A, B) -> eq(B, A))
    h40 = implies_intro h39
    h41 = implies_elim h40, h38
    h42 = forall_intro h41
    h43 = forall_intro h42
    h44 = forall_intro h43
    qed h44

# neqcomd
proof mm_neqcomd:
    fix A
    fix B
    fix S_ph
    fix u0
    hyp_mm_neqcomd_1 = assume (elem(u0, S_ph) -> ~eq(A, B))
    h1 = use mm_eqcom
    h2 = forall_elim h1, A
    h3 = forall_elim h2, B
    h4 = forall_elim h3, u0
    h5 = use wff_eq
    h6 = forall_elim h5, A
    h7 = forall_elim h6, B
    h9 = iota_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use wff_eq
    h12 = forall_elim h11, B
    h13 = forall_elim h12, A
    h15 = iota_elim h13, h14_w
    h16 = forall_elim h15, u0
    h17 = use mm_sylnib
    h18 = forall_elim h17, S_ph
    h19 = forall_elim h18, h8_w
    h20 = forall_elim h19, h14_w
    h21 = forall_elim h20, u0
    h22 = assume elem(u0, S_ph)
    h23 = implies_elim hyp_mm_neqcomd_1, h22
    h24 = assume elem(u0, h8_w)
    h25 = iff_elim_l h10, h24
    h26 = not_elim h23, h25
    h27 = not_intro h26
    h28 = implies_intro h27
    h29 = implies_elim h21, h28
    h30 = assume elem(u0, h8_w)
    h31 = iff_elim_l h10, h30
    h32 = iff_elim_l h4, h31
    h33 = iff_elim_r h16, h32
    h34 = implies_intro h33
    h35 = assume elem(u0, h14_w)
    h36 = iff_elim_l h16, h35
    h37 = iff_elim_r h4, h36
    h38 = iff_elim_r h10, h37
    h39 = implies_intro h38
    h40 = iff_intro h34, h39
    h41 = implies_elim h29, h40
    h42 = assume elem(u0, S_ph)
    h43 = implies_elim h41, h42
    h44 = assume eq(B, A)
    h45 = iff_elim_r h16, h44
    h46 = not_elim h43, h45
    h47 = not_intro h46
    h48 = implies_intro h47
    h49 = and_intro hyp_mm_neqcomd_1, h48
    h50 = and_elim_r h49
    h51 = implies_intro h50
    h52 = assume ((elem(u0, S_ph) -> ~eq(A, B)) -> (elem(u0, S_ph) -> ~eq(B, A)))
    h53 = implies_intro h52
    h54 = implies_elim h53, h51
    h55 = forall_intro h54
    h56 = forall_intro h55
    h57 = forall_intro h56
    h58 = forall_intro h57
    qed h58

