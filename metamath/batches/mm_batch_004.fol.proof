    h90 = iff_elim_r h75, h89
    h91 = implies_intro h90
    h92 = assume elem(u0, h58_w)
    h93 = iff_elim_l h75, h92
    h94 = iff_elim_r h29, h93
    h95 = iff_elim_r h81, h94
    h96 = implies_intro h95
    h97 = iff_intro h91, h96
    h98 = implies_elim h86, h97
    h99 = assume elem(u0, h79_w)
    h100 = iff_elim_l h81, h99
    h101 = implies_elim hyp_mm_ex_1, h100
    h102 = implies_intro h101
    h103 = implies_elim h98, h102
    h104 = assume ~(elem(u0, S_ph) -> ~elem(u0, S_ps))
    h105 = iff_elim_r h75, h104
