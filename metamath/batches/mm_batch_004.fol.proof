# Translated from Metamath set.mm

# simplr3
proof mm_simplr3:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix S_ta
    fix u0
    h1 = use mm_simp3
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = use wff_and
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h10 = iota_elim h8, h9_w
    h11 = use wff_and
    h12 = forall_elim h11, h9_w
    h13 = forall_elim h12, S_ch
    h15 = iota_elim h13, h14_w
    fix _bcv16
    h17 = forall_elim h15, _bcv16
    h18 = forall_elim h10, _bcv16
    h19 = assume elem(_bcv16, h14_w)
    h20 = iff_elim_l h17, h19
    h21 = and_elim_l h20
    h22 = iff_elim_l h18, h21
    h23 = and_elim_r h20
    h24 = and_intro h22, h23
    h25 = implies_intro h24
    h26 = assume ((elem(_bcv16, S_ph) & elem(_bcv16, S_ps)) & elem(_bcv16, S_ch))
    h27 = and_elim_l h26
    h28 = iff_elim_r h18, h27
    h29 = and_elim_r h26
    h30 = and_intro h28, h29
    h31 = iff_elim_r h17, h30
    h32 = implies_intro h31
    h33 = iff_intro h25, h32
    h34 = forall_intro h33
    h35 = use mm_ad2antlr
    h36 = forall_elim h35, h14_w
    h37 = forall_elim h36, S_ch
    h38 = forall_elim h37, S_th
    h39 = forall_elim h38, S_ta
    h40 = forall_elim h39, u0
    h41 = assume elem(u0, h14_w)
    h42 = forall_elim h34, u0
    h43 = iff_elim_l h42, h41
    h44 = implies_elim h5, h43
    h45 = implies_intro h44
    h46 = implies_elim h40, h45
    h47 = assume ((elem(u0, S_th) & ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))) & elem(u0, S_ta))
    h48 = and_elim_l h47
    h49 = and_elim_l h48
    h50 = and_elim_r h48
    h51 = forall_elim h34, u0
    h52 = iff_elim_r h51, h50
    h53 = and_intro h49, h52
    h54 = and_elim_r h47
    h55 = and_intro h53, h54
    h56 = implies_elim h46, h55
    h57 = implies_intro h56
    h58 = assume (((elem(u0, S_th) & ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))) & elem(u0, S_ta)) -> elem(u0, S_ch))
    h59 = implies_intro h58
    h60 = implies_elim h59, h57
    h61 = forall_intro h60
    h62 = forall_intro h61
    h63 = forall_intro h62
    h64 = forall_intro h63
    h65 = forall_intro h64
    h66 = forall_intro h65
    qed h66

