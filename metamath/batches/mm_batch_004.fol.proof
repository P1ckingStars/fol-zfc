# 2ex2rexrot
proof mm_2ex2rexrot:
    fix x
    fix y
    fix z
    fix w
    fix A
    fix B
    fix S_ph
    fix u0
    h1 = assume (exists z. (elem(z, A) & (exists w. (elem(w, B) & elem(u0, S_ph)))))
    h2 = implies_intro h1
    h3 = assume (exists z. (elem(z, A) & (exists w. (elem(w, B) & elem(u0, S_ph)))))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
