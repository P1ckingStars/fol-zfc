# Translated from Metamath set.mm

# axin1
proof mm_axin1:
    fix S_ph
    fix u0
    h1 = use mm_pm2_01
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, u0
    h4 = assume ((elem(u0, S_ph) -> ~elem(u0, S_ph)) -> ~elem(u0, S_ph))
    h5 = implies_intro h4
    h6 = implies_elim h5, h3
    h7 = forall_intro h6
    h8 = forall_intro h7
    qed h8

# axin2
proof mm_axin2:
    fix S_ph
    fix S_ps
    fix u0
    h1 = use mm_pm2_21
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = assume (~elem(u0, S_ph) -> (elem(u0, S_ph) -> elem(u0, S_ps)))
    h6 = implies_intro h5
    h7 = implies_elim h6, h4
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    qed h10

# axio
proof mm_axio:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    h1 = use mm_jaob
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = assume (((elem(u0, S_ph) | elem(u0, S_ch)) -> elem(u0, S_ps)) <-> ((elem(u0, S_ph) -> elem(u0, S_ps)) & (elem(u0, S_ch) -> elem(u0, S_ps))))
    h7 = implies_intro h6
    h8 = implies_elim h7, h5
    h9 = forall_intro h8
    h10 = forall_intro h9
    h11 = forall_intro h10
    h12 = forall_intro h11
    qed h12

# axi4
proof mm_axi4:
    fix x
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    qed h5

