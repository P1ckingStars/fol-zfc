# r19.26m
proof mm_r19_26m:
    fix x
    fix A
    fix B
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume ((elem(x, A) -> elem(u0, S_ph)) & (elem(x, B) -> elem(u0, S_ps)))
    h2 = implies_intro h1
    h3 = assume ((elem(x, A) -> elem(u0, S_ph)) & (elem(x, B) -> elem(u0, S_ps)))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    h11 = forall_intro h10
    qed h11

