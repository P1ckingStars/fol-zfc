    h19 = and_intro hyp_mm_pm2_21fal_1, h18
    h20 = and_elim_r h19
    h21 = implies_intro h20
    h22 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> ~elem(u0, S_ps)) -> (elem(u0, S_ph) -> ~(elem(u0, u0) -> elem(u0, u0)))))
