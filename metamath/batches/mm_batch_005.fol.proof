# Translated from Metamath set.mm

# jca
proof mm_jca:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_jca_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_jca_2 = assume (elem(u0, S_ph) -> elem(u0, S_ch))
    h1 = use mm_pm3_2
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ch
    h4 = forall_elim h3, u0
    h5 = use wff_and
    h6 = forall_elim h5, S_ps
    h7 = forall_elim h6, S_ch
    h9 = exists_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_sylc
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, S_ps
    h14 = forall_elim h13, S_ch
    h15 = forall_elim h14, h8_w
    h16 = forall_elim h15, u0
    h17 = implies_elim h16, hyp_mm_jca_1
    h18 = implies_elim h17, hyp_mm_jca_2
    h19 = assume elem(u0, S_ps)
    h20 = implies_elim h4, h19
    h21 = assume elem(u0, S_ch)
    h22 = implies_elim h20, h21
    h23 = iff_elim_r h10, h22
    h24 = implies_intro h23
    h25 = implies_intro h24
    h26 = implies_elim h18, h25
    h27 = assume elem(u0, S_ph)
    h28 = implies_elim h26, h27
    h29 = iff_elim_l h10, h28
    h30 = implies_intro h29
    h31 = exists_intro h30
    h32 = and_intro hyp_mm_jca_2, h31
    h33 = and_elim_r h32
    h34 = implies_intro h33
    h35 = and_intro hyp_mm_jca_1, h34
    h36 = and_elim_r h35
    h37 = implies_intro h36
    h38 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> (elem(u0, S_ps) & elem(u0, S_ch)))))
    h39 = implies_intro h38
    h40 = implies_elim h39, h37
    h41 = forall_intro h40
    h42 = forall_intro h41
    h43 = forall_intro h42
    h44 = forall_intro h43
    qed h44

# jcad
proof mm_jcad:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_jcad_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    hyp_mm_jcad_2 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_th)))
    h1 = use mm_pm3_2
    h2 = forall_elim h1, S_ch
    h3 = forall_elim h2, S_th
    h4 = forall_elim h3, u0
    h5 = use wff_and
    h6 = forall_elim h5, S_ch
    h7 = forall_elim h6, S_th
    h9 = exists_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_syl6c
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, S_ps
    h14 = forall_elim h13, S_ch
    h15 = forall_elim h14, S_th
    h16 = forall_elim h15, h8_w
    h17 = forall_elim h16, u0
    h18 = implies_elim h17, hyp_mm_jcad_1
    h19 = implies_elim h18, hyp_mm_jcad_2
    h20 = assume elem(u0, S_ch)
    h21 = implies_elim h4, h20
    h22 = assume elem(u0, S_th)
    h23 = implies_elim h21, h22
    h24 = iff_elim_r h10, h23
    h25 = implies_intro h24
    h26 = implies_intro h25
    h27 = implies_elim h19, h26
    h28 = assume elem(u0, S_ph)
    h29 = implies_elim h27, h28
    h30 = assume elem(u0, S_ps)
    h31 = implies_elim h29, h30
    h32 = iff_elim_l h10, h31
    h33 = implies_intro h32
    h34 = implies_intro h33
    h35 = exists_intro h34
    h36 = and_intro hyp_mm_jcad_2, h35
    h37 = and_elim_r h36
    h38 = implies_intro h37
    h39 = and_intro hyp_mm_jcad_1, h38
    h40 = and_elim_r h39
    h41 = implies_intro h40
    h42 = assume ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_th))) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_ch) & elem(u0, S_th))))))
    h43 = implies_intro h42
    h44 = implies_elim h43, h41
    h45 = forall_intro h44
    h46 = forall_intro h45
    h47 = forall_intro h46
    h48 = forall_intro h47
    h49 = forall_intro h48
    qed h49

# jca2
proof mm_jca2:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_jca2_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    hyp_mm_jca2_2 = assume (elem(u0, S_ps) -> elem(u0, S_th))
    h1 = use wff_impl
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_th
    h5 = exists_elim h3, h4_w
    h6 = forall_elim h5, u0
    h7 = use mm_a1i
    h8 = forall_elim h7, h4_w
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, u0
    h11 = iff_elim_r h6, hyp_mm_jca2_2
    h12 = implies_elim h10, h11
    h13 = assume elem(u0, S_ph)
    h14 = implies_elim h12, h13
    h15 = iff_elim_l h6, h14
    h16 = implies_intro h15
    h17 = exists_intro h16
    h18 = use mm_jcad
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ps
    h21 = forall_elim h20, S_ch
    h22 = forall_elim h21, S_th
    h23 = forall_elim h22, u0
    h24 = implies_elim h23, hyp_mm_jca2_1
    h25 = implies_elim h24, h17
    h26 = and_intro hyp_mm_jca2_2, h25
    h27 = and_elim_r h26
    h28 = implies_intro h27
    h29 = and_intro hyp_mm_jca2_1, h28
    h30 = and_elim_r h29
    h31 = implies_intro h30
    h32 = assume ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> ((elem(u0, S_ps) -> elem(u0, S_th)) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_ch) & elem(u0, S_th))))))
    h33 = implies_intro h32
    h34 = implies_elim h33, h31
    h35 = forall_intro h34
    h36 = forall_intro h35
    h37 = forall_intro h36
    h38 = forall_intro h37
    h39 = forall_intro h38
    qed h39

