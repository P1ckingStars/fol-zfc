    fix S_ph
    fix u0
    h1 = use mm_fal
    h2 = forall_elim h1, u0
    h3 = use wff_false
    h5 = iota_elim h3, h4_w
    h6 = use mm_mtt
    h7 = forall_elim h6, h4_w
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, u0
    h10 = assume ~ ~(elem(u0, u0) -> elem(u0, u0))
    h11 = assume elem(u0, h4_w)
    h12 = forall_elim h5, u0
    h13 = iff_elim_l h12, h11
    h14 = not_elim h10, h13
    h15 = not_intro h14
    h16 = implies_elim h9, h15
    h17 = assume ~elem(u0, S_ph)
    h18 = iff_elim_l h16, h17
    h19 = assume elem(u0, S_ph)
    h20 = implies_elim h18, h19
    h21 = forall_elim h5, u0
    h22 = iff_elim_l h21, h20
    h23 = implies_intro h22
    h24 = implies_intro h23
    h25 = assume (elem(u0, S_ph) -> ~(elem(u0, u0) -> elem(u0, u0)))
    h26 = assume elem(u0, S_ph)
    h27 = implies_elim h25, h26
    h28 = forall_elim h5, u0
    h29 = iff_elim_r h28, h27
    h30 = implies_intro h29
    h31 = iff_elim_r h16, h30
    h32 = implies_intro h31
    h33 = iff_intro h24, h32
    h34 = implies_intro h33
    h35 = implies_elim h34, h2
    h36 = assume (~elem(u0, S_ph) <-> (elem(u0, S_ph) -> ~(elem(u0, u0) -> elem(u0, u0))))
    h37 = implies_intro h36
    h38 = implies_elim h37, h35
    h39 = forall_intro h38
    h40 = forall_intro h39
    qed h40

# inegd
