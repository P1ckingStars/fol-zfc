    h7 = forall_elim h6, h3_w
    h8 = forall_elim h7, u0
    h9 = assume (elem(u0, S_ph) & elem(u0, h3_w))
    h10 = and_elim_l h9
    h11 = and_elim_r h9
    h12 = forall_elim h4, u0
    h13 = iff_elim_l h12, h11
    h14 = and_intro h10, h13
    h15 = implies_elim hyp_mm_efald_1, h14
    h16 = implies_intro h15
    h17 = implies_elim h8, h16
    h18 = assume elem(u0, S_ph)
    h19 = implies_elim h17, h18
    h20 = assume ~elem(u0, S_ps)
    h21 = forall_elim h4, u0
    h22 = iff_elim_r h21, h20
    h23 = not_elim h19, h22
    h24 = not_intro h23
    h25 = implies_intro h24
    h26 = use mm_notnotrd
    h27 = forall_elim h26, S_ph
    h28 = forall_elim h27, S_ps
    h29 = forall_elim h28, u0
    h30 = implies_elim h29, h25
    h31 = and_intro hyp_mm_efald_1, h30
    h32 = and_elim_r h31
    h33 = implies_intro h32
    h34 = assume (((elem(u0, S_ph) & ~elem(u0, S_ps)) -> ~(elem(u0, u0) -> elem(u0, u0))) -> (elem(u0, S_ph) -> elem(u0, S_ps)))
    h35 = implies_intro h34
    h36 = implies_elim h35, h33
    h37 = forall_intro h36
    h38 = forall_intro h37
