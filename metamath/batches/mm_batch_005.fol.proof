# trujust
proof mm_trujust:
    fix x
    fix y
    fix u0
    h1 = assume (elem(u0, u0) -> elem(u0, u0))
    h2 = implies_intro h1
    h3 = assume (elem(u0, u0) -> elem(u0, u0))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    qed h8

# tru
proof mm_tru:
    fix x
    fix u0
    h1 = assume elem(u0, u0)
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    qed h4

