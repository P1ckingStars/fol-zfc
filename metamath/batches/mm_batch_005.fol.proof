# efald
proof mm_efald:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_efald_1 = assume ((elem(u0, S_ph) & ~elem(u0, S_ps)) -> ~(elem(u0, u0) -> elem(u0, u0)))
