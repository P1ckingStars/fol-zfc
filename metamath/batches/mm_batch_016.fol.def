claim mm_nic_isw1: forall S_ph. forall S_th. forall u0. (~(elem(u0, S_th) & elem(u0, S_ph)) -> ~(elem(u0, S_ph) & elem(u0, S_th)))

# nic-isw2
claim mm_nic_isw2: forall S_ph. forall S_ps. forall S_th. forall u0. (~(elem(u0, S_ps) & ~(elem(u0, S_th) & elem(u0, S_ph))) -> ~(elem(u0, S_ps) & ~(elem(u0, S_ph) & elem(u0, S_th))))

