# Translated from Metamath set.mm

# nic-swap
claim mm_nic_swap: forall S_ph. forall S_th. forall S_ta. forall u0. ~(~(elem(u0, S_th) & elem(u0, S_ph)) & ~(~(elem(u0, S_ph) & elem(u0, S_th)) & ~(elem(u0, S_ph) & elem(u0, S_th))))

