# nfbii
proof mm_nfbii:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_nfbii_1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    h1 = use mm_nfbiit
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = use wff_bic
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h10 = iota_elim h8, h9_w
    h11 = use wff_impl
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, S_ph
    h15 = iota_elim h13, h14_w
    h16 = use wff_impl
    h17 = forall_elim h16, S_ps
    h18 = forall_elim h17, S_ps
    h20 = iota_elim h18, h19_w
    h21 = use wff_bic
    h22 = forall_elim h21, h14_w
    h23 = forall_elim h22, h19_w
    h25 = iota_elim h23, h24_w
    fix _bcv26
    h27 = forall_elim h25, _bcv26
    h28 = forall_elim h15, _bcv26
    h29 = forall_elim h20, _bcv26
    h30 = assume elem(_bcv26, h24_w)
    h31 = iff_elim_l h27, h30
    h32 = assume (elem(_bcv26, S_ph) -> elem(_bcv26, S_ph))
    h33 = iff_elim_r h28, h32
    h34 = iff_elim_l h31, h33
    h35 = iff_elim_l h29, h34
    h36 = implies_intro h35
    h37 = assume (elem(_bcv26, S_ps) -> elem(_bcv26, S_ps))
    h38 = iff_elim_r h29, h37
    h39 = iff_elim_r h31, h38
    h40 = iff_elim_l h28, h39
    h41 = implies_intro h40
    h42 = iff_intro h36, h41
    h43 = implies_intro h42
    h44 = assume ((elem(_bcv26, S_ph) -> elem(_bcv26, S_ph)) <-> (elem(_bcv26, S_ps) -> elem(_bcv26, S_ps)))
    h45 = assume elem(_bcv26, h14_w)
    h46 = iff_elim_l h28, h45
    h47 = iff_elim_l h44, h46
    h48 = iff_elim_r h29, h47
    h49 = implies_intro h48
    h50 = assume elem(_bcv26, h19_w)
    h51 = iff_elim_l h29, h50
    h52 = iff_elim_r h44, h51
    h53 = iff_elim_r h28, h52
    h54 = implies_intro h53
    h55 = iff_intro h49, h54
    h56 = iff_elim_r h27, h55
    h57 = implies_intro h56
    h58 = iff_intro h43, h57
    h59 = forall_intro h58
    h60 = use mm_mpg
    h61 = forall_elim h60, x
    h62 = forall_elim h61, h9_w
    h63 = forall_elim h62, h24_w
    h64 = forall_elim h63, u0
    h65 = assume elem(u0, h9_w)
    h66 = forall_elim h10, u0
    h67 = iff_elim_l h66, h65
    h68 = implies_elim h5, h67
    h69 = forall_elim h59, u0
    h70 = iff_elim_r h69, h68
    h71 = implies_intro h70
    h72 = implies_elim h64, h71
    h73 = forall_elim h10, u0
    h74 = iff_elim_r h73, hyp_mm_nfbii_1
    h75 = implies_elim h72, h74
    h76 = forall_elim h59, u0
    h77 = iff_elim_l h76, h75
    h78 = and_intro hyp_mm_nfbii_1, h77
    h79 = and_elim_r h78
    h80 = implies_intro h79
    h81 = assume ((elem(u0, S_ph) <-> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> elem(u0, S_ph)) <-> (elem(u0, S_ps) -> elem(u0, S_ps))))
    h82 = implies_intro h81
    h83 = implies_elim h82, h80
    h84 = forall_intro h83
    h85 = forall_intro h84
    h86 = forall_intro h85
    h87 = forall_intro h86
    qed h87

# nfxfr
proof mm_nfxfr:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_nfbii_1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    hyp_mm_nfxfr_2 = assume (elem(u0, S_ps) -> elem(u0, S_ps))
    h1 = use mm_nfbii
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_nfbii_1
    h7 = use wff_impl
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ph
    h11 = iota_elim h9, h10_w
    h12 = use wff_impl
    h13 = forall_elim h12, S_ps
    h14 = forall_elim h13, S_ps
    h16 = iota_elim h14, h15_w
    h17 = use mm_mpbir
    h18 = forall_elim h17, h10_w
    h19 = forall_elim h18, h15_w
    h20 = forall_elim h19, u0
    h21 = forall_elim h16, u0
    h22 = iff_elim_r h21, hyp_mm_nfxfr_2
    h23 = implies_elim h20, h22
    h24 = assume elem(u0, h10_w)
    h25 = forall_elim h11, u0
    h26 = iff_elim_l h25, h24
    h27 = iff_elim_l h6, h26
    h28 = forall_elim h16, u0
    h29 = iff_elim_r h28, h27
    h30 = implies_intro h29
    h31 = assume elem(u0, h15_w)
    h32 = forall_elim h16, u0
    h33 = iff_elim_l h32, h31
    h34 = iff_elim_r h6, h33
    h35 = forall_elim h11, u0
    h36 = iff_elim_r h35, h34
    h37 = implies_intro h36
    h38 = iff_intro h30, h37
    h39 = implies_elim h23, h38
    h40 = forall_elim h11, u0
    h41 = iff_elim_l h40, h39
    h42 = and_intro hyp_mm_nfxfr_2, h41
    h43 = and_elim_r h42
    h44 = implies_intro h43
    h45 = and_intro hyp_mm_nfbii_1, h44
    h46 = and_elim_r h45
    h47 = implies_intro h46
    h48 = assume ((elem(u0, S_ph) <-> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ph))))
    h49 = implies_intro h48
    h50 = implies_elim h49, h47
    h51 = forall_intro h50
    h52 = forall_intro h51
    h53 = forall_intro h52
    h54 = forall_intro h53
    qed h54

# nfxfrd
proof mm_nfxfrd:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
