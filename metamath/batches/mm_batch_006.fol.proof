# Translated from Metamath set.mm

# exnalimn
proof mm_exnalimn:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    h1 = use mm_alinexa
    h2 = forall_elim h1, x
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, u0
    h6 = use wff_neg
    h7 = forall_elim h6, S_ps
    h9 = iota_elim h7, h8_w
    h10 = use wff_impl
    h11 = forall_elim h10, S_ph
    h12 = forall_elim h11, h8_w
    h14 = iota_elim h12, h13_w
    fix _bcv15
    h16 = forall_elim h14, _bcv15
    h17 = forall_elim h9, _bcv15
    h18 = assume elem(_bcv15, h13_w)
    h19 = iff_elim_l h16, h18
    h20 = assume elem(_bcv15, S_ph)
    h21 = implies_elim h19, h20
    h22 = iff_elim_l h17, h21
    h23 = implies_intro h22
    h24 = implies_intro h23
    h25 = assume (elem(_bcv15, S_ph) -> ~elem(_bcv15, S_ps))
    h26 = assume elem(_bcv15, S_ph)
    h27 = implies_elim h25, h26
    h28 = iff_elim_r h17, h27
    h29 = implies_intro h28
    h30 = iff_elim_r h16, h29
    h31 = implies_intro h30
    h32 = iff_intro h24, h31
    h33 = forall_intro h32
    h34 = use wff_and
    h35 = forall_elim h34, S_ph
    h36 = forall_elim h35, S_ps
    h38 = iota_elim h36, h37_w
    h39 = use mm_con2bii
    h40 = forall_elim h39, h13_w
    h41 = forall_elim h40, h37_w
    h42 = forall_elim h41, u0
    h43 = assume elem(u0, h13_w)
    h44 = forall_elim h33, u0
    h45 = iff_elim_l h44, h43
    h46 = iff_elim_l h5, h45
    h47 = assume elem(u0, h37_w)
    h48 = forall_elim h38, u0
    h49 = iff_elim_l h48, h47
    h50 = not_elim h46, h49
    h51 = not_intro h50
    h52 = implies_intro h51
    h53 = assume ~elem(u0, h37_w)
    h54 = assume (elem(u0, S_ph) & elem(u0, S_ps))
    h55 = forall_elim h38, u0
    h56 = iff_elim_r h55, h54
    h57 = not_elim h53, h56
    h58 = not_intro h57
    h59 = iff_elim_r h5, h58
    h60 = forall_elim h33, u0
    h61 = iff_elim_r h60, h59
    h62 = implies_intro h61
    h63 = iff_intro h52, h62
    h64 = implies_elim h42, h63
    h65 = assume (elem(u0, S_ph) & elem(u0, S_ps))
    h66 = forall_elim h38, u0
    h67 = iff_elim_r h66, h65
    h68 = iff_elim_l h64, h67
    h69 = assume (elem(u0, S_ph) -> ~elem(u0, S_ps))
    h70 = forall_elim h33, u0
    h71 = iff_elim_r h70, h69
    h72 = not_elim h68, h71
    h73 = not_intro h72
    h74 = implies_intro h73
    h75 = assume ~(elem(u0, S_ph) -> ~elem(u0, S_ps))
    h76 = assume elem(u0, h13_w)
    h77 = forall_elim h33, u0
    h78 = iff_elim_l h77, h76
    h79 = not_elim h75, h78
    h80 = not_intro h79
    h81 = iff_elim_r h64, h80
    h82 = forall_elim h38, u0
    h83 = iff_elim_l h82, h81
    h84 = implies_intro h83
    h85 = iff_intro h74, h84
    h86 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) <-> ~(elem(u0, S_ph) -> ~elem(u0, S_ps)))
    h87 = implies_intro h86
    h88 = implies_elim h87, h85
    h89 = forall_intro h88
    h90 = forall_intro h89
    h91 = forall_intro h90
    h92 = forall_intro h91
    qed h92

# alexn
proof mm_alexn:
    fix x
    fix y
    fix S_ph
    fix u0
    h1 = assume ~elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = assume ~elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    qed h9

# 2exnexn
proof mm_2exnexn:
    fix x
    fix y
    fix S_ph
    fix u0
    h1 = use mm_alexn
    h2 = forall_elim h1, x
    h3 = forall_elim h2, y
    h4 = forall_elim h3, S_ph
    h5 = forall_elim h4, u0
    h6 = use wff_neg
    h7 = forall_elim h6, S_ph
    h9 = iota_elim h7, h8_w
    h10 = use mm_con2bii
    h11 = forall_elim h10, h8_w
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, u0
    h14 = assume elem(u0, h8_w)
    h15 = forall_elim h9, u0
    h16 = iff_elim_l h15, h14
    h17 = iff_elim_l h5, h16
    h18 = implies_intro h17
    h19 = assume ~elem(u0, S_ph)
    h20 = iff_elim_r h5, h19
    h21 = forall_elim h9, u0
    h22 = iff_elim_r h21, h20
    h23 = implies_intro h22
    h24 = iff_intro h18, h23
    h25 = implies_elim h13, h24
    h26 = assume elem(u0, S_ph)
    h27 = iff_elim_l h25, h26
    h28 = assume ~elem(u0, S_ph)
    h29 = forall_elim h9, u0
    h30 = iff_elim_r h29, h28
    h31 = not_elim h27, h30
    h32 = not_intro h31
    h33 = implies_intro h32
    h34 = assume ~ ~elem(u0, S_ph)
    h35 = assume elem(u0, h8_w)
    h36 = forall_elim h9, u0
    h37 = iff_elim_l h36, h35
    h38 = not_elim h34, h37
    h39 = not_intro h38
    h40 = iff_elim_r h25, h39
    h41 = implies_intro h40
    h42 = iff_intro h33, h41
    h43 = assume (elem(u0, S_ph) <-> ~ ~elem(u0, S_ph))
    h44 = implies_intro h43
    h45 = implies_elim h44, h42
    h46 = forall_intro h45
    h47 = forall_intro h46
    h48 = forall_intro h47
    h49 = forall_intro h48
    qed h49

# exbi
proof mm_exbi:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    h6 = forall_intro h5
    qed h6

