    h94 = forall_elim h63, u0
    h95 = iff_elim_r h94, h93
    h96 = iff_elim_r h85, h95
    h97 = forall_elim h34, u0
    h98 = iff_elim_l h97, h96
    h99 = implies_intro h98
    h100 = iff_intro h92, h99
    h101 = use wff_and
    h102 = forall_elim h101, S_ps
    h103 = forall_elim h102, S_ch
    h105 = iota_elim h103, h104_w
    h106 = use mm_19_42vv
    h107 = forall_elim h106, y
    h108 = forall_elim h107, z
    h109 = forall_elim h108, S_ph
    h110 = forall_elim h109, h104_w
    h111 = forall_elim h110, u0
    h112 = assume (elem(u0, S_ph) & (elem(u0, S_ps) & elem(u0, S_ch)))
    h113 = and_elim_l h112
    h114 = and_elim_r h112
    h115 = forall_elim h105, u0
    h116 = iff_elim_r h115, h114
    h117 = and_intro h113, h116
    h118 = iff_elim_l h111, h117
    h119 = and_elim_l h118
    h120 = and_elim_r h118
    h121 = forall_elim h105, u0
