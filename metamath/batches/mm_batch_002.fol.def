# anddi
claim mm_anddi: forall S_ph. forall S_ps. forall S_ch. forall S_th. forall u0. (((elem(u0, S_ph) | elem(u0, S_ps)) & (elem(u0, S_ch) | elem(u0, S_th))) <-> (((elem(u0, S_ph) & elem(u0, S_ch)) | (elem(u0, S_ph) & elem(u0, S_th))) | ((elem(u0, S_ps) & elem(u0, S_ch)) | (elem(u0, S_ps) & elem(u0, S_th)))))

# pm5.17
claim mm_pm5_17: forall S_ph. forall S_ps. forall u0. (((elem(u0, S_ph) | elem(u0, S_ps)) & ~(elem(u0, S_ph) & elem(u0, S_ps))) <-> (elem(u0, S_ph) <-> ~elem(u0, S_ps)))

# pm5.15
claim mm_pm5_15: forall S_ph. forall S_ps. forall u0. ((elem(u0, S_ph) <-> elem(u0, S_ps)) | (elem(u0, S_ph) <-> ~elem(u0, S_ps)))

# pm5.16
