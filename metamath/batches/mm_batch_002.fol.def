claim mm_niabn: forall S_ph. forall S_ps. forall S_ch. forall u0. (elem(u0, S_ph) -> (~elem(u0, S_ps) -> ((elem(u0, S_ch) & elem(u0, S_ps)) <-> ~elem(u0, S_ph))))

