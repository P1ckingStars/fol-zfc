# mtand
proof mm_mtand:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mtand_1 = assume (elem(u0, S_ph) -> ~elem(u0, S_ch))
    hyp_mm_mtand_2 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch))
    h1 = use mm_ex
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_mtand_2
    h7 = use mm_mtod
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_ps
    h10 = forall_elim h9, S_ch
    h11 = forall_elim h10, u0
    h12 = implies_elim h11, hyp_mm_mtand_1
    h13 = implies_elim h12, h6
    h14 = and_intro hyp_mm_mtand_2, h13
    h15 = and_elim_r h14
    h16 = implies_intro h15
    h17 = and_intro hyp_mm_mtand_1, h16
    h18 = and_elim_r h17
    h19 = implies_intro h18
    h20 = assume ((elem(u0, S_ph) -> ~elem(u0, S_ch)) -> (((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> ~elem(u0, S_ps))))
    h21 = implies_intro h20
    h22 = implies_elim h21, h19
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    h26 = forall_intro h25
    qed h26

