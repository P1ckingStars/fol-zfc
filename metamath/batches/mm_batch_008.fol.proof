# Translated from Metamath set.mm

# exbiri
proof mm_exbiri:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_exbiri_1 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) -> (elem(u0, S_ch) <-> elem(u0, S_th)))
    h1 = use wff_and
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h5 = exists_elim h3, h4_w
    h6 = forall_elim h5, u0
    h7 = use mm_biimpar
    h8 = forall_elim h7, h4_w
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, S_th
    h11 = forall_elim h10, u0
    h12 = assume elem(u0, h4_w)
    h13 = iff_elim_l h6, h12
    h14 = implies_elim hyp_mm_exbiri_1, h13
    h15 = implies_intro h14
    h16 = implies_elim h11, h15
    h17 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_th))
    h18 = and_elim_l h17
    h19 = iff_elim_r h6, h18
    h20 = and_elim_r h17
    h21 = and_intro h19, h20
    h22 = implies_elim h16, h21
    h23 = implies_intro h22
    h24 = exists_intro h23
    h25 = use mm_exp31
    h26 = forall_elim h25, S_ph
    h27 = forall_elim h26, S_ps
    h28 = forall_elim h27, S_th
    h29 = forall_elim h28, S_ch
    h30 = forall_elim h29, u0
    h31 = implies_elim h30, h24
    h32 = and_intro hyp_mm_exbiri_1, h31
    h33 = and_elim_r h32
    h34 = implies_intro h33
    h35 = assume (((elem(u0, S_ph) & elem(u0, S_ps)) -> (elem(u0, S_ch) <-> elem(u0, S_th))) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_th) -> elem(u0, S_ch)))))
    h36 = implies_intro h35
    h37 = implies_elim h36, h34
    h38 = forall_intro h37
    h39 = forall_intro h38
    h40 = forall_intro h39
    h41 = forall_intro h40
    h42 = forall_intro h41
    qed h42

