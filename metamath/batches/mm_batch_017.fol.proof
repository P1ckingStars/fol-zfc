# exlimddv
proof mm_exlimddv:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_exlimddv_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_exlimddv_2 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch))
    h1 = use mm_ex
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_exlimddv_2
    h7 = use mm_exlimdv
    h8 = forall_elim h7, x
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, S_ps
    h11 = forall_elim h10, S_ch
    h12 = forall_elim h11, u0
    h13 = implies_elim h12, h6
    h14 = use mm_mpd
    h15 = forall_elim h14, S_ph
    h16 = forall_elim h15, S_ps
    h17 = forall_elim h16, S_ch
    h18 = forall_elim h17, u0
    h19 = implies_elim h18, hyp_mm_exlimddv_1
    h20 = implies_elim h19, h13
    h21 = and_intro hyp_mm_exlimddv_2, h20
    h22 = and_elim_r h21
    h23 = implies_intro h22
    h24 = and_intro hyp_mm_exlimddv_1, h23
    h25 = and_elim_r h24
    h26 = implies_intro h25
    h27 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h28 = implies_intro h27
    h29 = implies_elim h28, h26
    h30 = forall_intro h29
    h31 = forall_intro h30
    h32 = forall_intro h31
    h33 = forall_intro h32
    h34 = forall_intro h33
    qed h34

