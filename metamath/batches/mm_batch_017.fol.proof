# empty
proof mm_empty:
    fix x
    fix u0
    h1 = assume ~(elem(u0, u0) -> elem(u0, u0))
    h2 = implies_intro h1
    h3 = assume ~(elem(u0, u0) -> elem(u0, u0))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    qed h7

# ax5d
proof mm_ax5d:
    fix x
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume elem(u0, S_ps)
    h2 = implies_intro h1
    h3 = use wff_impl
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, S_ps
    h7 = exists_elim h5, h6_w
    h8 = forall_elim h7, u0
    h9 = use mm_a1i
    h10 = forall_elim h9, h6_w
    h11 = forall_elim h10, S_ph
    h12 = forall_elim h11, u0
    h13 = iff_elim_r h8, h2
    h14 = implies_elim h12, h13
    h15 = assume elem(u0, S_ph)
    h16 = implies_elim h14, h15
    h17 = iff_elim_l h8, h16
    h18 = implies_intro h17
    h19 = exists_intro h18
    h20 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ps)))
    h21 = implies_intro h20
    h22 = implies_elim h21, h19
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    h26 = forall_intro h25
    qed h26

