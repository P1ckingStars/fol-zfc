    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    qed h5

# alcoms
proof mm_alcoms:
    fix x
    fix y
    fix S_ph
    fix S_ps
    fix u0
    h1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    qed h7

# alcom
proof mm_alcom:
    fix x
    fix y
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = assume elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    qed h9

# alrot3
proof mm_alrot3:
    fix x
    fix y
    fix z
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = assume elem(u0, S_ph)
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    qed h10

