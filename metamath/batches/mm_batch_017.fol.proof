# Translated from Metamath set.mm

# 19.26-3an
proof mm_19_26_3an:
    fix x
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    h1 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))
    h2 = implies_intro h1
    h3 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch))
    h4 = implies_intro h3
    h5 = iff_intro h2, h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    h8 = forall_intro h7
    h9 = forall_intro h8
    h10 = forall_intro h9
    qed h10

