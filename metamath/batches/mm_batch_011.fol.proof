    h26 = forall_elim h25, u0
    h27 = assume elem(u0, h24_w)
    h28 = iff_elim_l h26, h27
    h29 = and_elim_l h28
    h30 = iff_elim_l h20, h29
    h31 = and_elim_r h28
    h32 = and_intro h30, h31
