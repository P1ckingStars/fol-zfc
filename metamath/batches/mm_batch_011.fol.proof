    h56 = and_elim_l h55
    h57 = iff_elim_l h47, h56
    h58 = and_elim_r h55
    h59 = and_intro h57, h58
    h60 = implies_intro h59
    h61 = assume ((elem(u0, S_ps) & elem(u0, S_ch)) & elem(u0, S_th))
