# Translated from Metamath set.mm

# 3expa
proof mm_3expa:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    h1 = assume (((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch)) -> elem(u0, S_th))
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    h5 = forall_intro h4
    h6 = forall_intro h5
    h7 = forall_intro h6
    qed h7

# 3exp
proof mm_3exp:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_3exp_1 = assume (((elem(u0, S_ph) & elem(u0, S_ps)) & elem(u0, S_ch)) -> elem(u0, S_th))
    h1 = use mm_3expa
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, S_th
    h6 = forall_elim h5, u0
    h7 = implies_elim h6, hyp_mm_3exp_1
    h8 = use mm_exp31
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, S_ps
    h11 = forall_elim h10, S_ch
    h12 = forall_elim h11, S_th
    h13 = forall_elim h12, u0
    h14 = implies_elim h13, h7
    h15 = and_intro hyp_mm_3exp_1, h14
    h16 = and_elim_r h15
    h17 = implies_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    h20 = forall_intro h19
    h21 = forall_intro h20
    h22 = forall_intro h21
    qed h22

