    h71 = forall_elim h70, h24_w
    h72 = forall_elim h71, h51_w
    h73 = forall_elim h72, u0
    h74 = assume elem(u0, S_ph)
    h75 = implies_elim h9, h74
    h76 = iff_elim_r h41, h75
    h77 = implies_intro h76
    h78 = implies_elim h73, h77
    h79 = assume elem(u0, h51_w)
    h80 = iff_elim_l h68, h79
