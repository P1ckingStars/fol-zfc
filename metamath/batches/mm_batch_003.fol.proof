    h3 = forall_elim h2, x
    h4 = forall_elim h3, z
    h5 = forall_elim h4, u0
    h6 = use wff_eq
    h7 = forall_elim h6, y
    h8 = forall_elim h7, z
    h10 = iota_elim h8, h9_w
    h11 = forall_elim h10, u0
    h12 = use wff_eq
    h13 = forall_elim h12, x
