# anmp
proof mm_anmp:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_anmp_min = assume elem(u0, S_ph)
    hyp_mm_anmp_maj = assume (~elem(u0, S_ph) | elem(u0, S_ps))
    h1 = use mm_imorri
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_anmp_maj
    h6 = implies_elim h5, hyp_mm_anmp_min
    h7 = and_intro hyp_mm_anmp_maj, h6
    h8 = and_elim_r h7
