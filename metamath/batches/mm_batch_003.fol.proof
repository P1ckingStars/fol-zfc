    h43 = assume (((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch)) -> (((elem(u0, S_ph) & elem(u0, S_th)) -> elem(u0, S_ch)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) | elem(u0, S_th))) -> (elem(u0, S_ph) -> elem(u0, S_ch)))))
    h44 = implies_intro h43
