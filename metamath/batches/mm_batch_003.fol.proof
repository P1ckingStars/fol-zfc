    h29 = assume elem(u0, h9_w)
    h30 = iff_elim_l h11, h29
    h31 = implies_elim h5, h30
    h32 = assume elem(u0, h15_w)
    h33 = iff_elim_l h17, h32
    h34 = implies_elim h31, h33
    h35 = iff_elim_r h23, h34
    h36 = implies_intro h35
