    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_jaodan_1 = assume ((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch))
    hyp_mm_jaodan_2 = assume ((elem(u0, S_ph) & elem(u0, S_th)) -> elem(u0, S_ch))
    h1 = use mm_ex
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_jaodan_1
    h7 = use mm_ex
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, S_th
    h10 = forall_elim h9, S_ch
    h11 = forall_elim h10, u0
    h12 = implies_elim h11, hyp_mm_jaodan_2
    h13 = use mm_jaod
    h14 = forall_elim h13, S_ph
    h15 = forall_elim h14, S_ps
    h16 = forall_elim h15, S_ch
    h17 = forall_elim h16, S_th
    h18 = forall_elim h17, u0
    h19 = implies_elim h18, h6
    h20 = implies_elim h19, h12
    h21 = use wff_or
    h22 = forall_elim h21, S_ps
    h23 = forall_elim h22, S_th
    h25 = iota_elim h23, h24_w
    h26 = use mm_imp
    h27 = forall_elim h26, S_ph
    h28 = forall_elim h27, h24_w
    h29 = forall_elim h28, S_ch
    h30 = forall_elim h29, u0
    h31 = assume elem(u0, S_ph)
    h32 = implies_elim h20, h31
    h33 = assume elem(u0, h24_w)
    h34 = forall_elim h25, u0
    h35 = iff_elim_l h34, h33
    h36 = implies_elim h32, h35
    h37 = implies_intro h36
    h38 = implies_intro h37
    h39 = implies_elim h30, h38
    h40 = assume (elem(u0, S_ph) & (elem(u0, S_ps) | elem(u0, S_th)))
    h41 = and_elim_l h40
    h42 = and_elim_r h40
    h43 = forall_elim h25, u0
    h44 = iff_elim_r h43, h42
    h45 = and_intro h41, h44
    h46 = implies_elim h39, h45
    h47 = implies_intro h46
    h48 = and_intro hyp_mm_jaodan_2, h47
    h49 = and_elim_r h48
    h50 = implies_intro h49
    h51 = and_intro hyp_mm_jaodan_1, h50
    h52 = and_elim_r h51
    h53 = implies_intro h52
    h54 = assume (((elem(u0, S_ph) & elem(u0, S_ps)) -> elem(u0, S_ch)) -> (((elem(u0, S_ph) & elem(u0, S_th)) -> elem(u0, S_ch)) -> ((elem(u0, S_ph) & (elem(u0, S_ps) | elem(u0, S_th))) -> elem(u0, S_ch))))
    h55 = implies_intro h54
    h56 = implies_elim h55, h53
    h57 = forall_intro h56
    h58 = forall_intro h57
    h59 = forall_intro h58
    h60 = forall_intro h59
    h61 = forall_intro h60
    qed h61

