# Translated from Metamath set.mm

# orbi2i
proof mm_orbi2i:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_orbi2i_1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    h1 = use mm_biimpi
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_orbi2i_1
    h6 = use mm_orim2i
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h5
    h12 = use mm_biimpri
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, S_ps
    h15 = forall_elim h14, u0
    h16 = implies_elim h15, hyp_mm_orbi2i_1
    h17 = use mm_orim2i
    h18 = forall_elim h17, S_ps
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ch
    h21 = forall_elim h20, u0
    h22 = implies_elim h21, h16
    h23 = use wff_or
    h24 = forall_elim h23, S_ch
    h25 = forall_elim h24, S_ph
    h27 = iota_elim h25, h26_w
    h28 = use wff_or
    h29 = forall_elim h28, S_ch
    h30 = forall_elim h29, S_ps
    h32 = iota_elim h30, h31_w
    h33 = use mm_impbii
    h34 = forall_elim h33, h26_w
    h35 = forall_elim h34, h31_w
    h36 = forall_elim h35, u0
    h37 = assume elem(u0, h26_w)
    h38 = forall_elim h27, u0
    h39 = iff_elim_l h38, h37
    h40 = implies_elim h11, h39
    h41 = forall_elim h32, u0
    h42 = iff_elim_r h41, h40
    h43 = implies_intro h42
    h44 = implies_elim h36, h43
    h45 = assume elem(u0, h31_w)
    h46 = forall_elim h32, u0
    h47 = iff_elim_l h46, h45
    h48 = implies_elim h22, h47
    h49 = forall_elim h27, u0
    h50 = iff_elim_r h49, h48
    h51 = implies_intro h50
    h52 = implies_elim h44, h51
    h53 = assume (elem(u0, S_ch) | elem(u0, S_ph))
    h54 = forall_elim h27, u0
    h55 = iff_elim_r h54, h53
    h56 = iff_elim_l h52, h55
    h57 = forall_elim h32, u0
    h58 = iff_elim_l h57, h56
    h59 = implies_intro h58
    h60 = assume (elem(u0, S_ch) | elem(u0, S_ps))
    h61 = forall_elim h32, u0
    h62 = iff_elim_r h61, h60
    h63 = iff_elim_r h52, h62
    h64 = forall_elim h27, u0
    h65 = iff_elim_l h64, h63
    h66 = implies_intro h65
    h67 = iff_intro h59, h66
    h68 = and_intro hyp_mm_orbi2i_1, h67
    h69 = and_elim_r h68
    h70 = implies_intro h69
    h71 = assume ((elem(u0, S_ph) <-> elem(u0, S_ps)) -> ((elem(u0, S_ch) | elem(u0, S_ph)) <-> (elem(u0, S_ch) | elem(u0, S_ps))))
    h72 = implies_intro h71
    h73 = implies_elim h72, h70
    h74 = forall_intro h73
    h75 = forall_intro h74
    h76 = forall_intro h75
    h77 = forall_intro h76
    qed h77

