# mptnan
proof mm_mptnan:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_mptnan_min = assume elem(u0, S_ph)
    hyp_mm_mptnan_maj = assume ~(elem(u0, S_ph) & elem(u0, S_ps))
    h1 = use mm_imnani
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_mptnan_maj
    h6 = implies_elim h5, hyp_mm_mptnan_min
    h7 = and_intro hyp_mm_mptnan_maj, h6
    h8 = and_elim_r h7
    h9 = implies_intro h8
    h10 = and_intro hyp_mm_mptnan_min, h9
    h11 = and_elim_r h10
    h12 = implies_intro h11
    h13 = assume (elem(u0, S_ph) -> (~(elem(u0, S_ph) & elem(u0, S_ps)) -> ~elem(u0, S_ps)))
    h14 = implies_intro h13
    h15 = implies_elim h14, h12
    h16 = forall_intro h15
    h17 = forall_intro h16
    h18 = forall_intro h17
    qed h18

# mptxor
proof mm_mptxor:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_mptxor_min = assume elem(u0, S_ph)
    hyp_mm_mptxor_maj = assume ~(elem(u0, S_ph) <-> elem(u0, S_ps))
    h1 = use mm_xornan
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_mptxor_maj
    h6 = use mm_mptnan
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h9 = forall_elim h8, u0
    h10 = implies_elim h9, hyp_mm_mptxor_min
    h11 = implies_elim h10, h5
    h12 = and_intro hyp_mm_mptxor_maj, h11
    h13 = and_elim_r h12
    h14 = implies_intro h13
    h15 = and_intro hyp_mm_mptxor_min, h14
    h16 = and_elim_r h15
    h17 = implies_intro h16
    h18 = assume (elem(u0, S_ph) -> (~(elem(u0, S_ph) <-> elem(u0, S_ps)) -> ~elem(u0, S_ps)))
    h19 = implies_intro h18
    h20 = implies_elim h19, h17
    h21 = forall_intro h20
    h22 = forall_intro h21
    h23 = forall_intro h22
    qed h23

# mtpor
proof mm_mtpor:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_mtpor_min = assume ~elem(u0, S_ph)
    hyp_mm_mtpor_max = assume (elem(u0, S_ph) | elem(u0, S_ps))
    h1 = use mm_ori
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_mtpor_max
    h6 = implies_elim h5, hyp_mm_mtpor_min
    h7 = and_intro hyp_mm_mtpor_max, h6
    h8 = and_elim_r h7
    h9 = implies_intro h8
    h10 = and_intro hyp_mm_mtpor_min, h9
    h11 = and_elim_r h10
    h12 = implies_intro h11
    h13 = assume (~elem(u0, S_ph) -> ((elem(u0, S_ph) | elem(u0, S_ps)) -> elem(u0, S_ps)))
    h14 = implies_intro h13
    h15 = implies_elim h14, h12
    h16 = forall_intro h15
    h17 = forall_intro h16
    h18 = forall_intro h17
    qed h18

