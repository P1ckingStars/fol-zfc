# idd
proof mm_idd:
    fix S_ph
    fix S_ps
    fix u0
    h1 = use mm_id
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, u0
    h4 = use wff_impl
    h5 = forall_elim h4, S_ps
    h6 = forall_elim h5, S_ps
    h8 = exists_elim h6, h7_w
    h9 = forall_elim h8, u0
    h10 = use mm_a1i
    h11 = forall_elim h10, h7_w
    h12 = forall_elim h11, S_ph
    h13 = forall_elim h12, u0
    h14 = iff_elim_r h9, h3
