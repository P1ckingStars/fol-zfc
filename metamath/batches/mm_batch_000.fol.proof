# Translated from Metamath set.mm

# idi
proof mm_idi:
    fix S_ph
    fix u0
    h1 = assume elem(u0, S_ph)
    h2 = implies_intro h1
    h3 = forall_intro h2
    h4 = forall_intro h3
    qed h4

# a1ii
proof mm_a1ii:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_a1ii_1 = assume elem(u0, S_ph)
    hyp_mm_a1ii_2 = assume elem(u0, S_ps)
    h1 = and_intro hyp_mm_a1ii_2, hyp_mm_a1ii_1
    h2 = and_elim_r h1
    h3 = implies_intro h2
    h4 = and_intro hyp_mm_a1ii_1, h3
    h5 = and_elim_r h4
    h6 = implies_intro h5
    h7 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ph)))
    h8 = implies_intro h7
    h9 = implies_elim h8, h6
    h10 = forall_intro h9
    h11 = forall_intro h10
    h12 = forall_intro h11
    qed h12

# mp2
proof mm_mp2:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mp2_1 = assume elem(u0, S_ph)
    hyp_mm_mp2_2 = assume elem(u0, S_ps)
    hyp_mm_mp2_3 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = implies_elim hyp_mm_mp2_3, hyp_mm_mp2_1
    h2 = implies_elim h1, hyp_mm_mp2_2
    h3 = and_intro hyp_mm_mp2_3, h2
    h4 = and_elim_r h3
    h5 = implies_intro h4
    h6 = and_intro hyp_mm_mp2_2, h5
    h7 = and_elim_r h6
    h8 = implies_intro h7
    h9 = and_intro hyp_mm_mp2_1, h8
    h10 = and_elim_r h9
    h11 = implies_intro h10
    h12 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> elem(u0, S_ch))))
    h13 = implies_intro h12
    h14 = implies_elim h13, h11
    h15 = forall_intro h14
    h16 = forall_intro h15
    h17 = forall_intro h16
    h18 = forall_intro h17
    qed h18

# mp2b
proof mm_mp2b:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mp2b_1 = assume elem(u0, S_ph)
    hyp_mm_mp2b_2 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_mp2b_3 = assume (elem(u0, S_ps) -> elem(u0, S_ch))
    h1 = implies_elim hyp_mm_mp2b_2, hyp_mm_mp2b_1
    h2 = implies_elim hyp_mm_mp2b_3, h1
    h3 = and_intro hyp_mm_mp2b_3, h2
    h4 = and_elim_r h3
    h5 = implies_intro h4
    h6 = and_intro hyp_mm_mp2b_2, h5
    h7 = and_elim_r h6
    h8 = implies_intro h7
    h9 = and_intro hyp_mm_mp2b_1, h8
    h10 = and_elim_r h9
    h11 = implies_intro h10
    h12 = assume (elem(u0, S_ph) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> elem(u0, S_ch))))
    h13 = implies_intro h12
    h14 = implies_elim h13, h11
    h15 = forall_intro h14
    h16 = forall_intro h15
    h17 = forall_intro h16
    h18 = forall_intro h17
    qed h18

# a1i
proof mm_a1i:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_a1i_1 = assume elem(u0, S_ph)
    h1 = assume elem(u0, S_ph)
    h2 = assume elem(u0, S_ps)
    h3 = and_intro h1, h2
    h4 = and_elim_l h3
    h5 = implies_intro h4
    h6 = implies_intro h5
    h7 = implies_elim h6, hyp_mm_a1i_1
    h8 = and_intro hyp_mm_a1i_1, h7
    h9 = and_elim_r h8
    h10 = implies_intro h9
    h11 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ph)))
    h12 = implies_intro h11
    h13 = implies_elim h12, h10
    h14 = forall_intro h13
    h15 = forall_intro h14
    h16 = forall_intro h15
    qed h16

# 2a1i
proof mm_2a1i:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_2a1i_1 = assume elem(u0, S_ph)
    h1 = use mm_a1i
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ch
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_2a1i_1
    h6 = use wff_impl
    h7 = forall_elim h6, S_ch
    h8 = forall_elim h7, S_ph
    h10 = iota_elim h8, h9_w
    h11 = use mm_a1i
    h12 = forall_elim h11, h9_w
    h13 = forall_elim h12, S_ps
    h14 = forall_elim h13, u0
    h15 = forall_elim h10, u0
    h16 = iff_elim_r h15, h5
    h17 = implies_elim h14, h16
    h18 = assume elem(u0, S_ps)
    h19 = implies_elim h17, h18
    h20 = forall_elim h10, u0
    h21 = iff_elim_l h20, h19
    h22 = implies_intro h21
    h23 = and_intro hyp_mm_2a1i_1, h22
    h24 = and_elim_r h23
    h25 = implies_intro h24
    h26 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_ch) -> elem(u0, S_ph))))
    h27 = implies_intro h26
    h28 = implies_elim h27, h25
    h29 = forall_intro h28
    h30 = forall_intro h29
    h31 = forall_intro h30
    h32 = forall_intro h31
    qed h32

# mp1i
proof mm_mp1i:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mp1i_1 = assume elem(u0, S_ph)
    hyp_mm_mp1i_2 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h1 = implies_elim hyp_mm_mp1i_2, hyp_mm_mp1i_1
    h2 = use mm_a1i
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, h1
    h7 = and_intro hyp_mm_mp1i_2, h6
    h8 = and_elim_r h7
    h9 = implies_intro h8
    h10 = and_intro hyp_mm_mp1i_1, h9
    h11 = and_elim_r h10
    h12 = implies_intro h11
    h13 = assume (elem(u0, S_ph) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ch) -> elem(u0, S_ps))))
    h14 = implies_intro h13
    h15 = implies_elim h14, h12
    h16 = forall_intro h15
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    qed h19

# a2i
proof mm_a2i:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_a2i_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = assume elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))
    h2 = assume elem(u0, S_ph) -> elem(u0, S_ps)
    h3 = assume elem(u0, S_ph)
    h4 = implies_elim h1, h3
    h5 = implies_elim h2, h3
    h6 = implies_elim h4, h5
    h7 = implies_intro h6
    h8 = implies_intro h7
    h9 = implies_intro h8
    h10 = implies_elim h9, hyp_mm_a2i_1
    h11 = and_intro hyp_mm_a2i_1, h10
    h12 = and_elim_r h11
    h13 = implies_intro h12
    h14 = assume ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h15 = implies_intro h14
    h16 = implies_elim h15, h13
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    h20 = forall_intro h19
    qed h20

# mpd
proof mm_mpd:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mpd_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_mpd_2 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = use mm_a2i
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_mpd_2
    h7 = implies_elim h6, hyp_mm_mpd_1
    h8 = and_intro hyp_mm_mpd_2, h7
    h9 = and_elim_r h8
    h10 = implies_intro h9
    h11 = and_intro hyp_mm_mpd_1, h10
    h12 = and_elim_r h11
    h13 = implies_intro h12
    h14 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h15 = implies_intro h14
    h16 = implies_elim h15, h13
    h17 = forall_intro h16
    h18 = forall_intro h17
    h19 = forall_intro h18
    h20 = forall_intro h19
    qed h20

# imim2i
proof mm_imim2i:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_imim2i_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    h1 = use wff_impl
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h5 = iota_elim h3, h4_w
    h6 = use mm_a1i
    h7 = forall_elim h6, h4_w
    h8 = forall_elim h7, S_ch
    h9 = forall_elim h8, u0
    h10 = forall_elim h5, u0
    h11 = iff_elim_r h10, hyp_mm_imim2i_1
    h12 = implies_elim h9, h11
    h13 = assume elem(u0, S_ch)
    h14 = implies_elim h12, h13
    h15 = forall_elim h5, u0
    h16 = iff_elim_l h15, h14
    h17 = implies_intro h16
    h18 = use mm_a2i
    h19 = forall_elim h18, S_ch
    h20 = forall_elim h19, S_ph
    h21 = forall_elim h20, S_ps
    h22 = forall_elim h21, u0
    h23 = implies_elim h22, h17
    h24 = and_intro hyp_mm_imim2i_1, h23
    h25 = and_elim_r h24
    h26 = implies_intro h25
    h27 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ch) -> elem(u0, S_ph)) -> (elem(u0, S_ch) -> elem(u0, S_ps))))
    h28 = implies_intro h27
    h29 = implies_elim h28, h26
    h30 = forall_intro h29
    h31 = forall_intro h30
    h32 = forall_intro h31
    h33 = forall_intro h32
    qed h33

# syl
proof mm_syl:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_syl_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_syl_2 = assume (elem(u0, S_ps) -> elem(u0, S_ch))
    h1 = use wff_impl
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ch
    h5 = iota_elim h3, h4_w
    h6 = use mm_a1i
    h7 = forall_elim h6, h4_w
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, u0
    h10 = forall_elim h5, u0
    h11 = iff_elim_r h10, hyp_mm_syl_2
    h12 = implies_elim h9, h11
    h13 = assume elem(u0, S_ph)
    h14 = implies_elim h12, h13
    h15 = forall_elim h5, u0
    h16 = iff_elim_l h15, h14
    h17 = implies_intro h16
    h18 = use mm_mpd
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ps
    h21 = forall_elim h20, S_ch
    h22 = forall_elim h21, u0
    h23 = implies_elim h22, hyp_mm_syl_1
    h24 = implies_elim h23, h17
    h25 = and_intro hyp_mm_syl_2, h24
    h26 = and_elim_r h25
    h27 = implies_intro h26
    h28 = and_intro hyp_mm_syl_1, h27
    h29 = and_elim_r h28
    h30 = implies_intro h29
    h31 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h32 = implies_intro h31
    h33 = implies_elim h32, h30
    h34 = forall_intro h33
    h35 = forall_intro h34
    h36 = forall_intro h35
    h37 = forall_intro h36
    qed h37

# 3syl
proof mm_3syl:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix u0
    hyp_mm_3syl_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_3syl_2 = assume (elem(u0, S_ps) -> elem(u0, S_ch))
    hyp_mm_3syl_3 = assume (elem(u0, S_ch) -> elem(u0, S_th))
    h1 = use mm_syl
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, u0
    h6 = implies_elim h5, hyp_mm_3syl_1
    h7 = implies_elim h6, hyp_mm_3syl_2
    h8 = use mm_syl
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, S_ch
    h11 = forall_elim h10, S_th
    h12 = forall_elim h11, u0
    h13 = implies_elim h12, h7
    h14 = implies_elim h13, hyp_mm_3syl_3
    h15 = and_intro hyp_mm_3syl_3, h14
    h16 = and_elim_r h15
    h17 = implies_intro h16
    h18 = and_intro hyp_mm_3syl_2, h17
    h19 = and_elim_r h18
    h20 = implies_intro h19
    h21 = and_intro hyp_mm_3syl_1, h20
    h22 = and_elim_r h21
    h23 = implies_intro h22
    h24 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> ((elem(u0, S_ch) -> elem(u0, S_th)) -> (elem(u0, S_ph) -> elem(u0, S_th)))))
    h25 = implies_intro h24
    h26 = implies_elim h25, h23
    h27 = forall_intro h26
    h28 = forall_intro h27
    h29 = forall_intro h28
    h30 = forall_intro h29
    h31 = forall_intro h30
    qed h31

# 4syl
proof mm_4syl:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix S_ta
    fix u0
    hyp_mm_4syl_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_4syl_2 = assume (elem(u0, S_ps) -> elem(u0, S_ch))
    hyp_mm_4syl_3 = assume (elem(u0, S_ch) -> elem(u0, S_th))
    hyp_mm_4syl_4 = assume (elem(u0, S_th) -> elem(u0, S_ta))
    h1 = use mm_3syl
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, S_ch
    h5 = forall_elim h4, S_th
    h6 = forall_elim h5, u0
    h7 = implies_elim h6, hyp_mm_4syl_1
    h8 = implies_elim h7, hyp_mm_4syl_2
    h9 = implies_elim h8, hyp_mm_4syl_3
    h10 = use mm_syl
    h11 = forall_elim h10, S_ph
    h12 = forall_elim h11, S_th
    h13 = forall_elim h12, S_ta
    h14 = forall_elim h13, u0
    h15 = implies_elim h14, h9
    h16 = implies_elim h15, hyp_mm_4syl_4
    h17 = and_intro hyp_mm_4syl_4, h16
    h18 = and_elim_r h17
    h19 = implies_intro h18
    h20 = and_intro hyp_mm_4syl_3, h19
    h21 = and_elim_r h20
    h22 = implies_intro h21
    h23 = and_intro hyp_mm_4syl_2, h22
    h24 = and_elim_r h23
    h25 = implies_intro h24
    h26 = and_intro hyp_mm_4syl_1, h25
    h27 = and_elim_r h26
    h28 = implies_intro h27
    h29 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> ((elem(u0, S_ch) -> elem(u0, S_th)) -> ((elem(u0, S_th) -> elem(u0, S_ta)) -> (elem(u0, S_ph) -> elem(u0, S_ta))))))
    h30 = implies_intro h29
    h31 = implies_elim h30, h28
    h32 = forall_intro h31
    h33 = forall_intro h32
    h34 = forall_intro h33
    h35 = forall_intro h34
    h36 = forall_intro h35
    h37 = forall_intro h36
    qed h37

# mpi
proof mm_mpi:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_mpi_1 = assume elem(u0, S_ps)
    hyp_mm_mpi_2 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    h1 = use mm_a1i
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_mpi_1
    h6 = use mm_mpd
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h5
    h12 = implies_elim h11, hyp_mm_mpi_2
    h13 = and_intro hyp_mm_mpi_2, h12
    h14 = and_elim_r h13
    h15 = implies_intro h14
    h16 = and_intro hyp_mm_mpi_1, h15
    h17 = and_elim_r h16
    h18 = implies_intro h17
    h19 = assume (elem(u0, S_ps) -> ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h20 = implies_intro h19
    h21 = implies_elim h20, h18
    h22 = forall_intro h21
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    qed h25

