# intnan
proof mm_intnan:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_intnan_1 = assume ~elem(u0, S_ph)
    h1 = use mm_simpr
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, u0
    h5 = use wff_and
    h6 = forall_elim h5, S_ps
    h7 = forall_elim h6, S_ph
    h9 = iota_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use mm_mto
    h12 = forall_elim h11, h8_w
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, u0
    h15 = implies_elim h14, hyp_mm_intnan_1
    h16 = assume elem(u0, h8_w)
    h17 = iff_elim_l h10, h16
    h18 = implies_elim h4, h17
    h19 = implies_intro h18
    h20 = implies_elim h15, h19
    h21 = assume (elem(u0, S_ps) & elem(u0, S_ph))
    h22 = iff_elim_r h10, h21
    h23 = not_elim h20, h22
    h24 = not_intro h23
    h25 = and_intro hyp_mm_intnan_1, h24
    h26 = and_elim_r h25
    h27 = implies_intro h26
    h28 = assume (~elem(u0, S_ph) -> ~(elem(u0, S_ps) & elem(u0, S_ph)))
    h29 = implies_intro h28
    h30 = implies_elim h29, h27
    h31 = forall_intro h30
    h32 = forall_intro h31
    h33 = forall_intro h32
    qed h33

