# biimpi
proof mm_biimpi:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_biimpi_1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    h1 = use mm_biimp
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_biimpi_1
    h6 = and_intro hyp_mm_biimpi_1, h5
    h7 = and_elim_r h6
    h8 = implies_intro h7
    h9 = assume ((elem(u0, S_ph) <-> elem(u0, S_ps)) -> (elem(u0, S_ph) -> elem(u0, S_ps)))
    h10 = implies_intro h9
    h11 = implies_elim h10, h8
    h12 = forall_intro h11
    h13 = forall_intro h12
    h14 = forall_intro h13
    qed h14

# sylbi
proof mm_sylbi:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_sylbi_1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    hyp_mm_sylbi_2 = assume (elem(u0, S_ps) -> elem(u0, S_ch))
    h1 = use mm_biimpi
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_sylbi_1
    h6 = use mm_syl
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h5
    h12 = implies_elim h11, hyp_mm_sylbi_2
    h13 = and_intro hyp_mm_sylbi_2, h12
    h14 = and_elim_r h13
    h15 = implies_intro h14
    h16 = and_intro hyp_mm_sylbi_1, h15
    h17 = and_elim_r h16
    h18 = implies_intro h17
    h19 = assume ((elem(u0, S_ph) <-> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ch)) -> (elem(u0, S_ph) -> elem(u0, S_ch))))
    h20 = implies_intro h19
    h21 = implies_elim h20, h18
    h22 = forall_intro h21
    h23 = forall_intro h22
    h24 = forall_intro h23
    h25 = forall_intro h24
    qed h25

