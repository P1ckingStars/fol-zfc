# idd
proof mm_idd:
    fix S_ph
    fix S_ps
    fix u0
    h1 = use mm_id
    h2 = forall_elim h1, S_ps
    h3 = forall_elim h2, u0
    h4 = use wff_impl
    h5 = forall_elim h4, S_ps
    h6 = forall_elim h5, S_ps
    h8 = iota_elim h6, h7_w
    h9 = use mm_a1i
    h10 = forall_elim h9, h7_w
    h11 = forall_elim h10, S_ph
    h12 = forall_elim h11, u0
