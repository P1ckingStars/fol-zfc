    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix S_ta
    fix u0
    hyp_mm_syl8_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_ch) -> elem(u0, S_th))))
    hyp_mm_syl8_2 = assume (elem(u0, S_th) -> elem(u0, S_ta))
    h1 = use wff_impl
    h2 = forall_elim h1, S_th
    h3 = forall_elim h2, S_ta
    h5 = iota_elim h3, h4_w
    h6 = forall_elim h5, u0
    h7 = use mm_a1i
    h8 = forall_elim h7, h4_w
    h9 = forall_elim h8, S_ph
    h10 = forall_elim h9, u0
    h11 = iff_elim_r h6, hyp_mm_syl8_2
    h12 = implies_elim h10, h11
    h13 = assume elem(u0, S_ph)
    h14 = implies_elim h12, h13
    h15 = iff_elim_l h6, h14
    h16 = implies_intro h15
    h17 = use mm_syl6d
    h18 = forall_elim h17, S_ph
    h19 = forall_elim h18, S_ps
    h20 = forall_elim h19, S_ch
    h21 = forall_elim h20, S_th
    h22 = forall_elim h21, S_ta
    h23 = forall_elim h22, u0
    h24 = implies_elim h23, hyp_mm_syl8_1
    h25 = implies_elim h24, h16
    h26 = and_intro hyp_mm_syl8_2, h25
    h27 = and_elim_r h26
    h28 = implies_intro h27
    h29 = and_intro hyp_mm_syl8_1, h28
    h30 = and_elim_r h29
    h31 = implies_intro h30
    h32 = assume ((elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_ch) -> elem(u0, S_th)))) -> ((elem(u0, S_th) -> elem(u0, S_ta)) -> (elem(u0, S_ph) -> (elem(u0, S_ps) -> (elem(u0, S_ch) -> elem(u0, S_ta))))))
    h33 = implies_intro h32
    h34 = implies_elim h33, h31
    h35 = forall_intro h34
    h36 = forall_intro h35
    h37 = forall_intro h36
    h38 = forall_intro h37
    h39 = forall_intro h38
    h40 = forall_intro h39
    qed h40

