    h22 = and_elim_r h21
    h23 = implies_intro h22
    h24 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> (elem(u0, S_ch) -> ((elem(u0, S_ps) -> (elem(u0, S_ch) -> elem(u0, S_th))) -> (elem(u0, S_ph) -> elem(u0, S_th)))))
    h25 = implies_intro h24
    h26 = implies_elim h25, h23
    h27 = forall_intro h26
    h28 = forall_intro h27
    h29 = forall_intro h28
    h30 = forall_intro h29
    h31 = forall_intro h30
