    h16 = forall_elim h15, S_ph
    h17 = forall_elim h16, h12_w
    h18 = forall_elim h17, u0
    h19 = assume elem(u0, S_ph)
    h20 = implies_elim h8, h19
    h21 = assume elem(u0, S_ph)
    h22 = implies_elim h20, h21
    h23 = iff_elim_r h14, h22
    h24 = implies_intro h23
    h25 = implies_intro h24
    h26 = implies_elim h18, h25
    h27 = assume elem(u0, S_ph)
    h28 = implies_elim h26, h27
    h29 = iff_elim_l h14, h28
    h30 = implies_intro h29
