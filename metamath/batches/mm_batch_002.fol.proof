# impbid
proof mm_impbid:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_impbid_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    hyp_mm_impbid_2 = assume (elem(u0, S_ph) -> (elem(u0, S_ch) -> elem(u0, S_ps)))
    h1 = use mm_impbid21d
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ph
    h4 = forall_elim h3, S_ps
    h5 = forall_elim h4, S_ch
    h6 = forall_elim h5, u0
    h7 = implies_elim h6, hyp_mm_impbid_1
    h8 = implies_elim h7, hyp_mm_impbid_2
    h9 = use wff_bic
