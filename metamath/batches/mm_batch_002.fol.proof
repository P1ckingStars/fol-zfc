# Translated from Metamath set.mm

# anim12d1
proof mm_anim12d1:
    fix S_ph
    fix S_ps
    fix S_ch
    fix S_th
    fix S_ta
    fix u0
    hyp_mm_anim12d1_1 = assume (elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch)))
    hyp_mm_anim12d1_2 = assume (elem(u0, S_th) -> elem(u0, S_ta))
    h1 = use wff_impl
    h2 = forall_elim h1, S_th
    h3 = forall_elim h2, S_ta
    h5 = iota_elim h3, h4_w
    h6 = use mm_a1i
    h7 = forall_elim h6, h4_w
    h8 = forall_elim h7, S_ph
    h9 = forall_elim h8, u0
    h10 = forall_elim h5, u0
    h11 = iff_elim_r h10, hyp_mm_anim12d1_2
    h12 = implies_elim h9, h11
    h13 = assume elem(u0, S_ph)
    h14 = implies_elim h12, h13
    h15 = forall_elim h5, u0
    h16 = iff_elim_l h15, h14
    h17 = implies_intro h16
    h18 = use mm_anim12d
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ps
    h21 = forall_elim h20, S_ch
    h22 = forall_elim h21, S_th
    h23 = forall_elim h22, S_ta
    h24 = forall_elim h23, u0
    h25 = implies_elim h24, hyp_mm_anim12d1_1
    h26 = implies_elim h25, h17
    h27 = and_intro hyp_mm_anim12d1_2, h26
    h28 = and_elim_r h27
    h29 = implies_intro h28
    h30 = and_intro hyp_mm_anim12d1_1, h29
    h31 = and_elim_r h30
    h32 = implies_intro h31
    h33 = assume ((elem(u0, S_ph) -> (elem(u0, S_ps) -> elem(u0, S_ch))) -> ((elem(u0, S_th) -> elem(u0, S_ta)) -> (elem(u0, S_ph) -> ((elem(u0, S_ps) & elem(u0, S_th)) -> (elem(u0, S_ch) & elem(u0, S_ta))))))
    h34 = implies_intro h33
    h35 = implies_elim h34, h32
    h36 = forall_intro h35
    h37 = forall_intro h36
    h38 = forall_intro h37
    h39 = forall_intro h38
    h40 = forall_intro h39
    h41 = forall_intro h40
    qed h41

