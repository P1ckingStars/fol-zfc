# Translated from Metamath set.mm

# impbii
proof mm_impbii:
    fix S_ph
    fix S_ps
    fix u0
    hyp_mm_impbii_1 = assume (elem(u0, S_ph) -> elem(u0, S_ps))
    hyp_mm_impbii_2 = assume (elem(u0, S_ps) -> elem(u0, S_ph))
    h1 = use mm_impbi
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = use wff_impl
    h6 = forall_elim h5, S_ph
    h7 = forall_elim h6, S_ps
    h9 = exists_elim h7, h8_w
    h10 = forall_elim h9, u0
    h11 = use wff_impl
    h12 = forall_elim h11, S_ps
    h13 = forall_elim h12, S_ph
    h15 = exists_elim h13, h14_w
    h16 = forall_elim h15, u0
    h17 = use wff_bic
    h18 = forall_elim h17, S_ph
    h19 = forall_elim h18, S_ps
    h21 = exists_elim h19, h20_w
    h22 = forall_elim h21, u0
    h23 = use mm_mp2
    h24 = forall_elim h23, h8_w
    h25 = forall_elim h24, h14_w
    h26 = forall_elim h25, h20_w
    h27 = forall_elim h26, u0
    h28 = iff_elim_r h10, hyp_mm_impbii_1
    h29 = implies_elim h27, h28
    h30 = iff_elim_r h16, hyp_mm_impbii_2
    h31 = implies_elim h29, h30
    h32 = assume elem(u0, h8_w)
    h33 = iff_elim_l h10, h32
    h34 = implies_elim h4, h33
    h35 = assume elem(u0, h14_w)
    h36 = iff_elim_l h16, h35
    h37 = implies_elim h34, h36
    h38 = iff_elim_r h22, h37
    h39 = implies_intro h38
    h40 = implies_intro h39
    h41 = implies_elim h31, h40
    h42 = iff_elim_l h22, h41
    h43 = exists_intro h42
    h44 = exists_intro h43
    h45 = exists_intro h44
    h46 = and_intro hyp_mm_impbii_2, h45
    h47 = and_elim_r h46
    h48 = implies_intro h47
    h49 = and_intro hyp_mm_impbii_1, h48
    h50 = and_elim_r h49
    h51 = implies_intro h50
    h52 = assume ((elem(u0, S_ph) -> elem(u0, S_ps)) -> ((elem(u0, S_ps) -> elem(u0, S_ph)) -> (elem(u0, S_ph) <-> elem(u0, S_ps))))
    h53 = implies_intro h52
    h54 = implies_elim h53, h51
    h55 = forall_intro h54
    h56 = forall_intro h55
    h57 = forall_intro h56
    qed h57

