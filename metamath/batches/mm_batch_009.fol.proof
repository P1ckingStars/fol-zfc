# Translated from Metamath set.mm

# orbi2i
proof mm_orbi2i:
    fix S_ph
    fix S_ps
    fix S_ch
    fix u0
    hyp_mm_orbi2i_1 = assume (elem(u0, S_ph) <-> elem(u0, S_ps))
    h1 = use mm_biimpi
    h2 = forall_elim h1, S_ph
    h3 = forall_elim h2, S_ps
    h4 = forall_elim h3, u0
    h5 = implies_elim h4, hyp_mm_orbi2i_1
    h6 = use mm_orim2i
    h7 = forall_elim h6, S_ph
    h8 = forall_elim h7, S_ps
    h9 = forall_elim h8, S_ch
    h10 = forall_elim h9, u0
    h11 = implies_elim h10, h5
    h12 = use mm_biimpri
    h13 = forall_elim h12, S_ph
    h14 = forall_elim h13, S_ps
    h15 = forall_elim h14, u0
    h16 = implies_elim h15, hyp_mm_orbi2i_1
    h17 = use mm_orim2i
    h18 = forall_elim h17, S_ps
    h19 = forall_elim h18, S_ph
    h20 = forall_elim h19, S_ch
    h21 = forall_elim h20, u0
    h22 = implies_elim h21, h16
    h23 = use wff_or
    h24 = forall_elim h23, S_ch
    h25 = forall_elim h24, S_ph
    h27 = exists_elim h25, h26_w
    h28 = forall_elim h27, u0
    h29 = use wff_or
    h30 = forall_elim h29, S_ch
    h31 = forall_elim h30, S_ps
    h33 = exists_elim h31, h32_w
    h34 = forall_elim h33, u0
    h35 = use mm_impbii
    h36 = forall_elim h35, h26_w
    h37 = forall_elim h36, h32_w
    h38 = forall_elim h37, u0
    h39 = assume elem(u0, h26_w)
    h40 = iff_elim_l h28, h39
    h41 = implies_elim h11, h40
    h42 = iff_elim_r h34, h41
    h43 = implies_intro h42
    h44 = implies_elim h38, h43
    h45 = assume elem(u0, h32_w)
    h46 = iff_elim_l h34, h45
    h47 = implies_elim h22, h46
    h48 = iff_elim_r h28, h47
    h49 = implies_intro h48
    h50 = implies_elim h44, h49
    h51 = assume (elem(u0, S_ch) | elem(u0, S_ph))
    h52 = iff_elim_r h28, h51
    h53 = iff_elim_l h50, h52
    h54 = iff_elim_l h34, h53
    h55 = implies_intro h54
    h56 = assume (elem(u0, S_ch) | elem(u0, S_ps))
    h57 = iff_elim_r h34, h56
    h58 = iff_elim_r h50, h57
    h59 = iff_elim_l h28, h58
    h60 = implies_intro h59
    h61 = iff_intro h55, h60
    h62 = exists_intro h61
    h63 = exists_intro h62
    h64 = and_intro hyp_mm_orbi2i_1, h63
    h65 = and_elim_r h64
    h66 = implies_intro h65
    h67 = assume ((elem(u0, S_ph) <-> elem(u0, S_ps)) -> ((elem(u0, S_ch) | elem(u0, S_ph)) <-> (elem(u0, S_ch) | elem(u0, S_ps))))
    h68 = implies_intro h67
    h69 = implies_elim h68, h66
    h70 = forall_intro h69
    h71 = forall_intro h70
    h72 = forall_intro h71
    h73 = forall_intro h72
    qed h73

