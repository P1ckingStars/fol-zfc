# Set theory examples with declarations

# Declare empty set: no element belongs to it
declare emptyset : forall x. ~elem(x, emptyset)

# Claim: empty set is subset of any set
# This would require: forall A. forall x. (elem(x, emptyset) -> elem(x, A))
# Which follows from: ~elem(x, emptyset) implies (elem(x, emptyset) -> anything)

# Reflexivity claims
claim forall x. forall A. (elem(x, A) -> elem(x, A))

# Declare a specific set with a property
declare singleton_zero : forall x. (elem(x, singleton_zero) <-> eq(x, zero))

# Define zero as a constant (no special properties for now)
declare zero : forall x. (eq(zero, zero))
